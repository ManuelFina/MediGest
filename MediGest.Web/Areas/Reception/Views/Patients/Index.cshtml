
@model MediGest.Web.ViewModels.Patients.PatientListViewModel

@{
    ViewData["Title"] = "Pacientes";
}

<div class="container-fluid py-4">

    <!-- Encabezado -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="bi bi-people-fill text-primary me-2"></i>
                Pacientes
            </h2>
            <p class="text-muted mb-0">
                Administración y consulta de pacientes del consultorio.
            </p>
        </div>

        <a asp-area="Reception"
           asp-controller="Patients"
           asp-action="Create"
           class="btn btn-primary px-4 py-2">
            <i class="bi bi-person-plus-fill me-2"></i>
            Registrar paciente
        </a>
    </div>

    <!-- Mensajes -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm"
             role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm"
             role="alert">
            <i class="bi bi-exclamation-circle-fill me-2"></i>
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    <!-- Estadísticas -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card patient-stat-card h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon bg-primary-subtle text-primary">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div class="ms-3">
                        <p class="text-muted mb-1">Total de pacientes</p>
                        <h3 class="fw-bold mb-0">@Model.TotalPatients</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card patient-stat-card h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon bg-success-subtle text-success">
                        <i class="bi bi-person-check-fill"></i>
                    </div>
                    <div class="ms-3">
                        <p class="text-muted mb-1">Pacientes activos</p>
                        <h3 class="fw-bold mb-0">@Model.ActivePatients</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card patient-stat-card h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="stat-icon bg-secondary-subtle text-secondary">
                        <i class="bi bi-person-x-fill"></i>
                    </div>
                    <div class="ms-3">
                        <p class="text-muted mb-1">Pacientes inactivos</p>
                        <h3 class="fw-bold mb-0">@Model.InactivePatients</h3>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Listado -->
    <div class="card patient-main-card">

        <div class="card-header bg-white border-0 px-4 pt-4 pb-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h5 class="fw-bold mb-1">Listado de pacientes</h5>
                    <p class="text-muted small mb-0">
                        Consultá y administrá los pacientes registrados.
                    </p>
                </div>
            </div>
        </div>

        <div class="card-body px-4">

            <!-- Búsqueda -->
            <form asp-area="Reception"
                  asp-controller="Patients"
                  asp-action="Index"
                  method="get"
                  class="row g-2 mb-4"
                  id="patientSearchForm">

                <div class="col-md-6 col-lg-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="bi bi-search text-muted"></i>
                        </span>

                        <input type="text"
                               id="patientSearchInput"
                               name="searchTerm"
                               value="@Model.SearchTerm"
                               class="form-control border-start-0"
                               placeholder="Buscar por nombre, apellido o documento..."
                               autocomplete="off" />
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                {
                    <div class="col-auto">
                        <a asp-area="Reception"
                           asp-controller="Patients"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg me-1"></i>
                            Limpiar
                        </a>
                    </div>
                }

            </form>

            <!-- Tabla -->
            <div class="table-responsive">
                <table class="table align-middle patient-table">
                    <thead>
                        <tr>
                            <th>Paciente</th>
                            <th>Documento</th>
                            <th>Teléfono</th>
                            <th>Email</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Patients.Any())
                        {
                            @foreach (var patient in Model.Patients)
                            {
                                var fullName = $"{patient.FirstName} {patient.LastName}".Trim();

                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="patient-avatar">
                                                @(
                                                    !string.IsNullOrWhiteSpace(patient.FirstName)
                                                        ? patient.FirstName.Substring(0, 1).ToUpper()
                                                        : "P"
                                                )
                                            </div>
                                            <div>
                                                <div class="fw-semibold text-dark">
                                                    @fullName
                                                </div>
                                                <small class="text-muted">
                                                    Paciente #@patient.Id
                                                </small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        @patient.DocumentNumber
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(patient.PhoneNumber)
                                            ? "Sin teléfono"
                                            : patient.PhoneNumber)
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(patient.Email)
                                            ? "Sin email"
                                            : patient.Email)
                                    </td>

                                    <td>
                                        @if (patient.IsActive)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success px-3 py-2">
                                                <i class="bi bi-check-circle-fill me-1"></i>
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary-subtle text-secondary px-3 py-2">
                                                <i class="bi bi-pause-circle-fill me-1"></i>
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-end gap-2">

                                            <a asp-area="Reception"
                                               asp-controller="Patients"
                                               asp-action="Edit"
                                               asp-route-id="@patient.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Editar paciente">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            @if (patient.IsActive)
                                            {
                                                <form asp-area="Reception"
                                                      asp-controller="Patients"
                                                      asp-action="Deactivate"
                                                      asp-route-id="@patient.Id"
                                                      method="post"
                                                      onsubmit="return confirm('¿Estás seguro de que deseas desactivar este paciente?');">

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Desactivar paciente">
                                                        <i class="bi bi-person-x"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-area="Reception"
                                                      asp-controller="Patients"
                                                      asp-action="Activate"
                                                      asp-route-id="@patient.Id"
                                                      method="post"
                                                      onsubmit="return confirm('¿Deseas volver a activar este paciente?');">

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success"
                                                            title="Activar paciente">
                                                        <i class="bi bi-person-check"></i>
                                                    </button>
                                                </form>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <i class="bi bi-person-x display-5 text-muted"></i>
                                    <h6 class="fw-semibold mt-3">
                                        No se encontraron pacientes
                                    </h6>
                                    <p class="text-muted mb-0">
                                        No hay pacientes que coincidan con la búsqueda.
                                    </p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
                <small class="text-muted">
                    Pacientes encontrados: <strong>@Model.Patients.Count()</strong>
                </small>
            </div>

        </div>
    </div>

</div>

<style>
    .patient-stat-card,
    .patient-main-card {
        background: #fff;
        border: 1px solid #e8eef6;
        border-radius: 16px;
        box-shadow: 0 4px 18px rgba(31, 55, 90, 0.045);
    }

    .patient-stat-card .card-body {
        padding: 1.4rem;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 1.35rem;
    }

    .patient-main-card {
        overflow: hidden;
    }

    .patient-table {
        margin-bottom: 0;
    }

    .patient-table thead th {
        background: #f7f9fc;
        color: #64748b;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .035em;
        padding: 1rem .85rem;
        border-bottom: 1px solid #e8eef6;
        white-space: nowrap;
    }

    .patient-table tbody td {
        padding: 1rem .85rem;
        border-bottom: 1px solid #edf1f6;
        color: #475569;
        font-size: .9rem;
    }

    .patient-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .patient-table tbody tr:hover {
        background: #f8fbff;
    }

    .patient-avatar {
        width: 40px;
        height: 40px;
        min-width: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #eaf2ff;
        color: #2674ed;
        font-weight: 700;
        font-size: 1rem;
    }

    .patient-table .btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
    }

    .patient-table form {
        display: inline-flex;
    }

    @@media (max-width: 768px) {
        .patient-main-card .card-body {
            padding: 1rem !important;
        }

        .patient-main-card .card-header {
            padding: 1rem !important;
        }
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchForm = document.getElementById("patientSearchForm");
        const searchInput = document.getElementById("patientSearchInput");

        if (!searchForm || !searchInput) {
            return;
        }

        let searchTimeout;

        searchInput.addEventListener("input", function () {
            clearTimeout(searchTimeout);

            searchTimeout = setTimeout(function () {
                searchForm.requestSubmit();
            }, 400);
        });
    });
</script>
