
@model MediGest.Web.ViewModels.Invoices.InvoiceFormViewModel

@using System.Globalization

@{
    ViewData["Title"] = "Nueva factura";

    var culture = new CultureInfo("es-AR");
    var details = Model.Details.Any()
        ? Model.Details
        : new List<MediGest.Web.ViewModels.Invoices.InvoiceDetailFormViewModel>
        {
            new()
        };

    var selectedPatientId = Model.PatientId;
    var createUrl = Url.Action("Create", "Invoices", new { area = "Reception" });
}

<div class="container-fluid">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="mb-1">Nueva factura</h2>
            <p class="text-muted mb-0">
                Registrá las prestaciones y los importes correspondientes.
            </p>
        </div>

        <a asp-area="Reception"
           asp-controller="Invoices"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Volver
        </a>
    </div>

    <form asp-area="Reception"
          asp-controller="Invoices"
          asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert"></div>

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0">
                    <i class="bi bi-person-vcard me-2"></i>
                    Datos del paciente
                </h5>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-12 col-lg-6">
                        <label asp-for="PatientId" class="form-label"></label>

                        <select asp-for="PatientId"
                                class="form-select"
                                id="patientSelect"
                                required>
                            <option value="">Seleccionar paciente...</option>
                            @foreach (var patient in Model.Patients)
                            {
                                <option value="@patient.Value"
                                        selected="@(patient.Value == selectedPatientId.ToString())">
                                    @patient.Text
                                </option>
                            }
                        </select>

                        <span asp-validation-for="PatientId"
                              class="text-danger"></span>

                        <small class="text-muted">
                            Al seleccionar otro paciente se actualizarán sus afiliaciones y turnos.
                        </small>
                    </div>

                    <div class="col-12 col-lg-6">
                        <label asp-for="PatientAffiliationId" class="form-label"></label>

                        <select asp-for="PatientAffiliationId"
                                class="form-select"
                                id="affiliationSelect">
                            <option value="">Atención particular / Sin cobertura</option>

                            @foreach (var affiliation in Model.Affiliations)
                            {
                                <option value="@affiliation.Value">
                                    @affiliation.Text
                                </option>
                            }
                        </select>

                        <span asp-validation-for="PatientAffiliationId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="IssueDate" class="form-label"></label>

                        <input asp-for="IssueDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="IssueDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Notes" class="form-label"></label>

                        <textarea asp-for="Notes"
                                  class="form-control"
                                  rows="2"
                                  placeholder="Observaciones adicionales..."></textarea>

                        <span asp-validation-for="Notes"
                              class="text-danger"></span>
                    </div>

                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-4">

            <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h5 class="mb-0">
                    <i class="bi bi-clipboard2-pulse me-2"></i>
                    Prestaciones
                </h5>

                <button type="button"
                        id="addDetailButton"
                        class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus-circle me-1"></i>
                    Agregar prestación
                </button>
            </div>

            <div class="card-body">

                <div id="detailsContainer">

                    @for (var i = 0; i < details.Count; i++)
                    {
                        <div class="detail-row border rounded-3 p-3 mb-3">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="mb-0 detail-title">
                                    Prestación @(i + 1)
                                </h6>

                                <button type="button"
                                        class="btn btn-sm btn-outline-danger remove-detail"
                                        title="Eliminar prestación"
                                        @(details.Count == 1 ? "disabled" : null)>
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>

                            <div class="row g-3">

                                <div class="col-12 col-lg-6">
                                    <label class="form-label">Prestación médica</label>

                                    <select name="Details[@i].MedicalServiceId"
                                            class="form-select"
                                            required>
                                        <option value="">Seleccionar prestación...</option>

                                        @foreach (var service in Model.MedicalServices)
                                        {
                                            <option value="@service.Value"
                                                    selected="@(service.Value == details[i].MedicalServiceId.ToString())">
                                                @service.Text
                                            </option>
                                        }
                                    </select>

                                    <span class="text-danger field-validation-valid"
                                          data-valmsg-for="Details[@i].MedicalServiceId"
                                          data-valmsg-replace="true"></span>
                                </div>

                                <div class="col-12 col-lg-6">
                                    <label class="form-label">Turno asociado</label>

                                    <select name="Details[@i].AppointmentId"
                                            class="form-select">
                                        <option value="">Sin turno asociado</option>

                                        @foreach (var appointment in details[i].Appointments)
                                        {
                                            <option value="@appointment.Value"
                                                    selected="@(appointment.Value == details[i].AppointmentId?.ToString())">
                                                @appointment.Text
                                            </option>
                                        }
                                    </select>
                                </div>

                                <div class="col-12 col-md-4">
                                    <label class="form-label">Fecha de prestación</label>

                                    <input type="date"
                                           name="Details[@i].ServiceDate"
                                           value="@details[i].ServiceDate.ToString("yyyy-MM-dd")"
                                           class="form-control"
                                           required />
                                </div>

                                <div class="col-12 col-md-4">
                                    <label class="form-label">Cantidad</label>

                                    <input type="number"
                                           name="Details[@i].Quantity"
                                           value="@details[i].Quantity"
                                           min="1"
                                           max="9999"
                                           class="form-control"
                                           required />
                                </div>

                                <div class="col-12 col-md-4">
                                    <label class="form-label">Número de autorización</label>

                                    <input type="text"
                                           name="Details[@i].AuthorizationNumber"
                                           value="@details[i].AuthorizationNumber"
                                           maxlength="100"
                                           class="form-control"
                                           placeholder="Opcional" />
                                </div>

                            </div>
                        </div>
                    }

                </div>

                <div class="alert alert-info mb-0">
                    <i class="bi bi-info-circle me-2"></i>
                    Los importes se calcularán automáticamente según el precio de la prestación
                    y la tarifa vigente del plan seleccionado. No necesitás ingresar precios manualmente.
                </div>

            </div>
        </div>

        <div class="d-flex flex-wrap justify-content-end gap-2 mb-4">

            <a asp-area="Reception"
               asp-controller="Invoices"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Cancelar
            </a>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-receipt me-1"></i>
                Emitir factura
            </button>

        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const container = document.getElementById("detailsContainer");
            const addButton = document.getElementById("addDetailButton");
            const patientSelect = document.getElementById("patientSelect");

            const createUrl = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(createUrl));

            const serviceOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Model.MedicalServices.Select(s => new { value = s.Value, text = s.Text })
            ));

            const appointmentOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                details.FirstOrDefault()?.Appointments.Select(a => new { value = a.Value, text = a.Text })
                ?? Enumerable.Empty<object>()
            ));

            function escapeHtml(value) {
                return String(value)
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;")
                    .replaceAll("'", "&#039;");
            }

            function createOptions(options, placeholder) {
                let html = `<option value="">${placeholder}</option>`;

                options.forEach(option => {
                    html += `<option value="${escapeHtml(option.value)}">${escapeHtml(option.text)}</option>`;
                });

                return html;
            }

            function updateIndexes() {
                const rows = container.querySelectorAll(".detail-row");

                rows.forEach((row, index) => {
                    row.querySelector(".detail-title").textContent =
                        `Prestación ${index + 1}`;

                    row.querySelectorAll("[name]").forEach(input => {
                        input.name = input.name.replace(
                            /Details\[\d+\]/g,
                            `Details[${index}]`
                        );
                    });

                    row.querySelectorAll("[data-valmsg-for]").forEach(message => {
                        message.setAttribute(
                            "data-valmsg-for",
                            message.getAttribute("data-valmsg-for")
                                .replace(/Details\[\d+\]/g, `Details[${index}]`)
                        );
                    });

                    const removeButton = row.querySelector(".remove-detail");
                    removeButton.disabled = rows.length === 1;
                });
            }

            function addDetail() {
                const index = container.querySelectorAll(".detail-row").length;

                const row = document.createElement("div");
                row.className = "detail-row border rounded-3 p-3 mb-3";

                row.innerHTML = `
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="mb-0 detail-title">Prestación ${index + 1}</h6>

                        <button type="button"
                                class="btn btn-sm btn-outline-danger remove-detail"
                                title="Eliminar prestación">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>

                    <div class="row g-3">

                        <div class="col-12 col-lg-6">
                            <label class="form-label">Prestación médica</label>

                            <select name="Details[${index}].MedicalServiceId"
                                    class="form-select"
                                    required>
                                ${createOptions(serviceOptions, "Seleccionar prestación...")}
                            </select>
                        </div>

                        <div class="col-12 col-lg-6">
                            <label class="form-label">Turno asociado</label>

                            <select name="Details[${index}].AppointmentId"
                                    class="form-select">
                                ${createOptions(appointmentOptions, "Sin turno asociado")}
                            </select>
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label">Fecha de prestación</label>

                            <input type="date"
                                   name="Details[${index}].ServiceDate"
                                   value="${new Date().toLocaleDateString("en-CA")}"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label">Cantidad</label>

                            <input type="number"
                                   name="Details[${index}].Quantity"
                                   value="1"
                                   min="1"
                                   max="9999"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="col-12 col-md-4">
                            <label class="form-label">Número de autorización</label>

                            <input type="text"
                                   name="Details[${index}].AuthorizationNumber"
                                   maxlength="100"
                                   class="form-control"
                                   placeholder="Opcional" />
                        </div>

                    </div>
                `;

                container.appendChild(row);
                updateIndexes();
            }

            addButton.addEventListener("click", addDetail);

            container.addEventListener("click", function (event) {
                const button = event.target.closest(".remove-detail");

                if (!button || button.disabled) {
                    return;
                }

                button.closest(".detail-row").remove();
                updateIndexes();
            });

            patientSelect.addEventListener("change", function () {
                if (!this.value) {
                    window.location.href = createUrl;
                    return;
                }

                window.location.href =
                    `${createUrl}?patientId=${encodeURIComponent(this.value)}`;
            });

            updateIndexes();
        });
    </script>
}
