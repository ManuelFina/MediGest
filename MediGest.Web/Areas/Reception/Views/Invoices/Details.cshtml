
@model MediGest.Web.ViewModels.Invoices.InvoiceDetailsViewModel

@using MediGest.Web.Models.Enums
@using System.Globalization

@{
    ViewData["Title"] = "Detalle de factura";

    var culture = new CultureInfo("es-AR");

    var statusLabel = Model.Status switch
    {
        InvoiceStatus.Pending => "Pendiente",
        InvoiceStatus.PartiallyPaid => "Pago parcial",
        InvoiceStatus.Paid => "Pagada",
        InvoiceStatus.Cancelled => "Anulada",
        _ => "Desconocido"
    };

    var statusClass = Model.Status switch
    {
        InvoiceStatus.Pending => "bg-warning text-dark",
        InvoiceStatus.PartiallyPaid => "bg-info text-dark",
        InvoiceStatus.Paid => "bg-success",
        InvoiceStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="container-fluid">

    <!-- Encabezado y acciones -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3 no-print">

        <div>
            <h2 class="mb-1">Detalle de factura</h2>
            <p class="text-muted mb-0">
                Comprobante @Model.Number
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">

            <a asp-area="Reception"
               asp-controller="Invoices"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Volver
            </a>

            <button type="button"
                    class="btn btn-outline-danger"
                    onclick="window.print()">
                <i class="bi bi-file-pdf me-1"></i>
                Descargar PDF
            </button>

            @if (Model.Status != InvoiceStatus.Cancelled &&
                 Model.PendingAmount > 0)
            {
                <a asp-area="Reception"
                   asp-controller="Invoices"
                   asp-action="RegisterPayment"
                   asp-route-invoiceId="@Model.Id"
                   class="btn btn-success">
                    <i class="bi bi-cash-coin me-1"></i>
                    Registrar pago
                </a>
            }

        </div>
    </div>

    <!-- Mensajes -->
    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show no-print"
             role="alert">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show no-print"
             role="alert">
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Encabezado del comprobante -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <div class="row align-items-start g-3">

                <div class="col-12 col-md-7">

                    <div class="d-flex align-items-center gap-3 mb-3">

                        <div class="rounded-3 bg-primary bg-opacity-10 p-3">
                            <i class="bi bi-hospital text-primary fs-2"></i>
                        </div>

                        <div>
                            <h4 class="mb-0">MediGest</h4>
                            <span class="text-muted">
                                Sistema de gestión médica
                            </span>
                        </div>

                    </div>

                    <p class="text-muted mb-0">
                        Comprobante interno de prestaciones médicas.
                    </p>

                </div>

                <div class="col-12 col-md-5 text-md-end">

                    <h5 class="text-muted mb-1">COMPROBANTE</h5>

                    <h4 class="fw-bold mb-2">
                        @Model.Number
                    </h4>

                    <span class="badge @statusClass fs-6">
                        @statusLabel
                    </span>

                    <p class="text-muted mt-2 mb-0">
                        Fecha de emisión:
                        <strong>
                            @Model.IssueDate.ToString("dd/MM/yyyy")
                        </strong>
                    </p>

                </div>

            </div>

            <hr class="my-4" />

            <!-- Datos del paciente y cobertura -->
            <div class="row g-4">

                <div class="col-12 col-lg-6">

                    <h6 class="text-muted text-uppercase mb-3">
                        Datos del paciente
                    </h6>

                    <p class="mb-1">
                        <strong>Nombre:</strong>
                        @Model.PatientName
                    </p>

                    <p class="mb-1">
                        <strong>Documento:</strong>
                        @Model.PatientDocumentNumber
                    </p>

                    <p class="mb-0">
                        <strong>Teléfono:</strong>
                        @(string.IsNullOrWhiteSpace(Model.PatientPhoneNumber)
                            ? "No informado"
                            : Model.PatientPhoneNumber)
                    </p>

                </div>

                <div class="col-12 col-lg-6">

                    <h6 class="text-muted text-uppercase mb-3">
                        Cobertura médica
                    </h6>

                    @if (!string.IsNullOrWhiteSpace(Model.HealthInsuranceName))
                    {
                        <p class="mb-1">
                            <strong>Obra social:</strong>
                            @Model.HealthInsuranceName
                        </p>

                        <p class="mb-1">
                            <strong>Plan:</strong>
                            @Model.HealthPlanName
                        </p>

                        <p class="mb-0">
                            <strong>Número de afiliado:</strong>
                            @(string.IsNullOrWhiteSpace(Model.MembershipNumber)
                                ? "No informado"
                                : Model.MembershipNumber)
                        </p>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Atención particular
                        </span>
                    }

                </div>

            </div>

        </div>
    </div>

    <!-- Prestaciones -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0">
                <i class="bi bi-clipboard2-pulse me-2"></i>
                Prestaciones facturadas
            </h5>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Prestación</th>
                            <th>Fecha</th>
                            <th>Cantidad</th>
                            <th>Precio unitario</th>
                            <th>Cobertura por unidad</th>
                            <th>Subtotal</th>
                            <th>Cobertura</th>
                            <th>A cargo del paciente</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var detail in Model.Details)
                        {
                            <tr>

                                <td class="ps-3">

                                    <strong>
                                        @detail.Description
                                    </strong>

                                    @if (detail.AppointmentId.HasValue)
                                    {
                                        <div>
                                            <small class="text-muted">
                                                Turno #@detail.AppointmentId
                                            </small>
                                        </div>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(detail.AuthorizationNumber))
                                    {
                                        <div>
                                            <small class="text-muted">
                                                Autorización:
                                                @detail.AuthorizationNumber
                                            </small>
                                        </div>
                                    }

                                </td>

                                <td>
                                    @detail.ServiceDate.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @detail.Quantity
                                </td>

                                <td>
                                    @detail.UnitPrice.ToString("C2", culture)
                                </td>

                                <td>
                                    @detail.UnitCoverageAmount.ToString("C2", culture)
                                </td>

                                <td>
                                    @detail.Subtotal.ToString("C2", culture)
                                </td>

                                <td class="text-success">
                                    @detail.CoverageAmount.ToString("C2", culture)
                                </td>

                                <td class="fw-semibold">
                                    @detail.PatientAmount.ToString("C2", culture)
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

    <!-- Resumen e historial de pagos -->
    <div class="row g-4 mb-4">

        <div class="col-12 col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-cash-stack me-2"></i>
                        Resumen de importes
                    </h5>
                </div>

                <div class="card-body">

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Subtotal</span>

                        <strong>
                            @Model.Subtotal.ToString("C2", culture)
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Cobertura médica</span>

                        <strong class="text-success">
                            - @Model.CoverageAmount.ToString("C2", culture)
                        </strong>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-3">
                        <span class="fw-semibold">
                            Total de prestaciones
                        </span>

                        <strong>
                            @Model.Total.ToString("C2", culture)
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="fw-semibold">
                            A cargo del paciente
                        </span>

                        <h5 class="mb-0">
                            @Model.PatientAmount.ToString("C2", culture)
                        </h5>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">
                            Total abonado
                        </span>

                        <strong class="text-success">
                            @Model.PaidAmount.ToString("C2", culture)
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-semibold">
                            Saldo pendiente
                        </span>

                        <h4 class="mb-0 @(Model.PendingAmount > 0 ? "text-danger" : "text-success")">
                            @Model.PendingAmount.ToString("C2", culture)
                        </h4>
                    </div>

                </div>
            </div>

        </div>

        <div class="col-12 col-lg-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-wallet2 me-2"></i>
                        Historial de pagos
                    </h5>
                </div>

                <div class="card-body p-0">

                    @if (Model.Payments.Any())
                    {
                        <div class="table-responsive">

                            <table class="table table-hover align-middle mb-0">

                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Fecha</th>
                                        <th>Medio</th>
                                        <th>Referencia</th>
                                        <th class="text-end pe-3">Importe</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var payment in Model.Payments.OrderByDescending(p => p.PaymentDate))
                                    {
                                        var methodLabel = payment.Method switch
                                        {
                                            PaymentMethod.Cash => "Efectivo",
                                            PaymentMethod.DebitCard => "Tarjeta de débito",
                                            PaymentMethod.CreditCard => "Tarjeta de crédito",
                                            PaymentMethod.BankTransfer => "Transferencia",
                                            PaymentMethod.Other => "Otro",
                                            _ => "Desconocido"
                                        };

                                        <tr>

                                            <td class="ps-3">
                                                @payment.PaymentDate.ToString("dd/MM/yyyy")
                                            </td>

                                            <td>
                                                @methodLabel
                                            </td>

                                            <td>
                                                @(string.IsNullOrWhiteSpace(payment.Reference)
                                                    ? "-"
                                                    : payment.Reference)
                                            </td>

                                            <td class="text-end pe-3 fw-semibold">
                                                @payment.Amount.ToString("C2", culture)
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">

                            <i class="bi bi-wallet text-muted fs-2"></i>

                            <p class="text-muted mt-2 mb-0">
                                Todavía no se registraron pagos.
                            </p>

                        </div>
                    }

                </div>
            </div>

        </div>

    </div>

    <!-- Observaciones -->
    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <div class="card border-0 shadow-sm mb-4">

            <div class="card-body">

                <h6 class="fw-semibold">
                    <i class="bi bi-chat-left-text me-2"></i>
                    Observaciones
                </h6>

                <p class="text-muted mb-0">
                    @Model.Notes
                </p>

            </div>
        </div>
    }

    <!-- Acciones inferiores -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 no-print">

        <a asp-area="Reception"
           asp-controller="Invoices"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Volver al listado
        </a>

        @if (Model.Status != InvoiceStatus.Cancelled &&
             !Model.Payments.Any())
        {
            <form asp-area="Reception"
                  asp-controller="Invoices"
                  asp-action="Cancel"
                  asp-route-id="@Model.Id"
                  method="post"
                  onsubmit="return confirm('¿Estás seguro de que deseas anular esta factura? Esta acción no se puede deshacer.');">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-outline-danger">
                    <i class="bi bi-x-circle me-1"></i>
                    Anular factura
                </button>

            </form>
        }

    </div>

</div>


@section Styles {
    <style>
        @@media print {
            @@page {
                size: A4;
                margin: 12mm;
            }

            body {
                background: white !important;
                font-size: 11px !important;
                color: #212529 !important;
            }

            .no-print,
            header,
            footer,
            nav,
            aside,
            .sidebar,
            .navbar {
                display: none !important;
            }

            .mg-main,
            .mg-content,
            .container-fluid {
                width: 100% !important;
                max-width: 100% !important;
                padding: 0 !important;
                margin: 0 !important;
            }

            .card {
                box-shadow: none !important;
                border: 1px solid #dee2e6 !important;
                break-inside: avoid;
            }

            .card-header {
                background: #f8f9fa !important;
                color: #212529 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .table {
                font-size: 9px !important;
            }

            .table-responsive {
                overflow: visible !important;
            }

            .badge {
                border: 1px solid #adb5bd;
                color: #212529 !important;
                background: white !important;
            }

            .text-success,
            .text-danger,
            .text-primary {
                color: #212529 !important;
            }

            .row {
                break-inside: avoid;
            }

            h2, h4, h5, h6 {
                break-after: avoid;
            }

            a {
                text-decoration: none !important;
                color: inherit !important;
            }
        }
    </style>
}
