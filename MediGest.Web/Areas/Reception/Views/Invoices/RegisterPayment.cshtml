@model MediGest.Web.ViewModels.Invoices.PaymentFormViewModel

@using MediGest.Web.Models.Enums
@using System.Globalization

@{
    ViewData["Title"] = "Registrar pago";

    var culture = new CultureInfo("es-AR");
}

<div class="container-fluid">

    <!-- Encabezado -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="mb-1">Registrar cobro</h2>
            <p class="text-muted mb-0">
                Confirmación del cobro de la factura emitida.
            </p>
        </div>

        <a asp-area="Reception"
           asp-controller="Invoices"
           asp-action="Details"
           asp-route-id="@Model.InvoiceId"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Volver a la factura
        </a>
    </div>

    <!-- Errores de validación -->
    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert"></div>

    <div class="row g-4">

        <!-- Resumen de factura -->
        <div class="col-12 col-lg-5">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-receipt me-2"></i>
                        Resumen de factura
                    </h5>
                </div>

                <div class="card-body">

                    <div class="mb-3">
                        <small class="text-muted d-block">
                            Número de comprobante
                        </small>

                        <h5 class="fw-bold mb-0">
                            @Model.InvoiceNumber
                        </h5>
                    </div>

                    <div class="mb-3">
                        <small class="text-muted d-block">
                            Paciente
                        </small>

                        <h6 class="mb-0">
                            @Model.PatientName
                        </h6>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">
                            Importe a cargo del paciente
                        </span>

                        <strong>
                            @Model.InvoiceAmount.ToString("C2", culture)
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">
                            Total abonado
                        </span>

                        <strong class="text-success">
                            @Model.PaidAmount.ToString("C2", culture)
                        </strong>
                    </div>

                    <hr />

                    <div class="bg-light rounded p-3">
                        <small class="text-muted d-block mb-1">
                            Importe a cobrar
                        </small>

                        <h2 class="text-success fw-bold mb-0">
                            @Model.PendingAmount.ToString("C2", culture)
                        </h2>
                    </div>

                    <div class="mt-3">
                        <span class="badge bg-warning text-dark">
                            <i class="bi bi-clock me-1"></i>
                            Pendiente de cobro
                        </span>
                    </div>

                </div>
            </div>

        </div>

        <!-- Formulario de cobro -->
        <div class="col-12 col-lg-7">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-cash-coin me-2"></i>
                        Confirmar cobro
                    </h5>
                </div>

                <div class="card-body">

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        Para completar la operación, registrá el pago por el importe total pendiente.
                    </div>

                    <form asp-area="Reception"
                          asp-controller="Invoices"
                          asp-action="RegisterPayment"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="InvoiceId" type="hidden" />

                        <!-- Fecha -->
                        <div class="mb-3">

                            <label asp-for="PaymentDate"
                                   class="form-label"></label>

                            <input asp-for="PaymentDate"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="PaymentDate"
                                  class="text-danger"></span>

                        </div>

                        <!-- Importe -->
                        <div class="mb-3">

                            <label class="form-label">
                                Importe del cobro
                            </label>

                            <div class="input-group input-group-lg">

                                <span class="input-group-text">$</span>

                                <input type="text"
                                       class="form-control fw-bold"
                                       value="@Model.PendingAmount.ToString("N2", culture)"
                                       readonly
                                       aria-label="Importe total a cobrar" />

                            </div>

                            <small class="text-muted">
                                El importe se calcula automáticamente a partir de la factura.
                            </small>

                        </div>

                        <!-- Medio de pago -->
                        <div class="mb-3">

                            <label asp-for="Method"
                                   class="form-label"></label>

                            <select asp-for="Method"
                                    class="form-select"
                                    asp-items="Html.GetEnumSelectList<PaymentMethod>()">

                                <option value="">Seleccionar medio de pago...</option>

                            </select>

                            <span asp-validation-for="Method"
                                  class="text-danger"></span>

                        </div>

                        <!-- Referencia -->
                        <div class="mb-3">

                            <label asp-for="Reference"
                                   class="form-label"></label>

                            <input asp-for="Reference"
                                   class="form-control"
                                   placeholder="Número de operación o comprobante" />

                            <span asp-validation-for="Reference"
                                  class="text-danger"></span>

                        </div>

                        <!-- Observaciones -->
                        <div class="mb-3">

                            <label asp-for="Notes"
                                   class="form-label"></label>

                            <textarea asp-for="Notes"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Observaciones adicionales..."></textarea>

                            <span asp-validation-for="Notes"
                                  class="text-danger"></span>

                        </div>

                        <hr class="my-4" />

                        <!-- Acciones -->
                        <div class="d-flex flex-wrap justify-content-between gap-2">

                            <a asp-area="Reception"
                               asp-controller="Invoices"
                               asp-action="Details"
                               asp-route-id="@Model.InvoiceId"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-success">
                                <i class="bi bi-check-circle me-1"></i>
                                Confirmar cobro
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
