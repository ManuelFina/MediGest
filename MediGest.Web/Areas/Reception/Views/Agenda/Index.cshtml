
@model MediGest.Web.ViewModels.Appointments.DailyAgendaViewModel

@{
    ViewData["Title"] = "Agenda diaria";

    var previousDate = Model.SelectedDate.AddDays(-1);
    var nextDate = Model.SelectedDate.AddDays(1);
    var today = DateOnly.FromDateTime(DateTime.Today);

    var appointments = Model.Appointments.ToList();

    var totalAppointments = appointments.Count;
    var pendingAppointments = appointments.Count(a => a.Status == "Pending");
    var confirmedAppointments = appointments.Count(a => a.Status == "Confirmed");
    var waitingAppointments = appointments.Count(a => a.Status == "Waiting");
    var completedAppointments = appointments.Count(a => a.Status == "Completed");

    string GetStatusClass(string status)
    {
        return status switch
        {
            "Pending" => "status-pending",
            "Confirmed" => "status-confirmed",
            "Waiting" => "status-waiting",
            "Completed" => "status-completed",
            "Cancelled" => "status-cancelled",
            "NoShow" => "status-noshow",
            _ => "status-default"
        };
    }

    string GetStatusText(string status)
    {
        return status switch
        {
            "Pending" => "Pendiente",
            "Confirmed" => "Confirmado",
            "Waiting" => "En espera",
            "Completed" => "Completado",
            "Cancelled" => "Cancelado",
            "NoShow" => "Ausente",
            _ => status
        };
    }
}

<style>
    .daily-agenda {
        color: #263b59;
        padding: 10px 0 25px;
    }

    /* HEADER */

    .daily-agenda .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
        margin-bottom: 22px;
    }

    .daily-agenda .heading-content {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .daily-agenda .heading-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf1ff;
        color: #2868d7;
        border-radius: 12px;
        font-size: 1.4rem;
    }

    .daily-agenda .page-title {
        margin: 0;
        color: #263b59;
        font-size: 1.55rem;
        font-weight: 750;
    }

    .daily-agenda .page-subtitle {
        margin: 4px 0 0;
        color: #8492a6;
        font-size: .84rem;
    }

    .daily-agenda .btn-create {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        border: 0;
        border-radius: 9px;
        background: #2868d7;
        color: white;
        font-size: .86rem;
        font-weight: 650;
        text-decoration: none;
        transition: .2s;
    }

    .daily-agenda .btn-create:hover {
        background: #1d54b3;
        color: white;
        transform: translateY(-1px);
    }

    /* DATE AND FILTERS */

    .daily-agenda .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
        padding: 17px 19px;
        margin-bottom: 19px;
        background: white;
        border: 1px solid #e8edf4;
        border-radius: 12px;
        box-shadow: 0 2px 9px rgba(35, 59, 92, .035);
    }

    .daily-agenda .date-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .daily-agenda .date-label {
        color: #8996a9;
        font-size: .73rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .daily-agenda .date-title {
        margin: 0;
        color: #304966;
        font-size: 1.05rem;
        font-weight: 750;
        text-transform: capitalize;
    }

    .daily-agenda .date-actions {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .daily-agenda .date-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 37px;
        height: 36px;
        padding: 0 11px;
        border: 1px solid #e1e8f1;
        border-radius: 8px;
        background: white;
        color: #526b8c;
        font-size: .8rem;
        font-weight: 650;
        text-decoration: none;
        transition: .2s;
    }

    .daily-agenda .date-button:hover {
        background: #f0f5ff;
        border-color: #c9d9f7;
        color: #2868d7;
    }

    .daily-agenda .date-button.today {
        background: #2868d7;
        border-color: #2868d7;
        color: white;
    }

    .daily-agenda .filters {
        display: flex;
        align-items: end;
        gap: 10px;
        flex-wrap: wrap;
    }

    .daily-agenda .filter-group {
        min-width: 155px;
    }

    .daily-agenda .filter-label {
        display: block;
        margin-bottom: 5px;
        color: #718198;
        font-size: .72rem;
        font-weight: 700;
    }

    .daily-agenda .filter-control {
        min-height: 37px;
        border: 1px solid #e1e8f1;
        border-radius: 8px;
        color: #405873;
        font-size: .81rem;
    }

    .daily-agenda .btn-filter {
        min-height: 37px;
        padding: 7px 13px;
        border: 0;
        border-radius: 8px;
        background: #edf3ff;
        color: #2868d7;
        font-size: .8rem;
        font-weight: 700;
    }

    .daily-agenda .btn-filter:hover {
        background: #dfeaff;
    }

    /* STATISTICS */

    .daily-agenda .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 13px;
        margin-bottom: 23px;
    }

    .daily-agenda .stat-card {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
        padding: 16px;
        background: white;
        border: 1px solid #e8edf4;
        border-radius: 11px;
        box-shadow: 0 2px 9px rgba(35, 59, 92, .035);
    }

    .daily-agenda .stat-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 42px;
        height: 42px;
        border-radius: 10px;
        font-size: 1.15rem;
    }

    .daily-agenda .stat-total .stat-icon {
        background: #edf3ff;
        color: #2868d7;
    }

    .daily-agenda .stat-pending .stat-icon {
        background: #fff4df;
        color: #c18a24;
    }

    .daily-agenda .stat-confirmed .stat-icon {
        background: #e8f1ff;
        color: #3977d2;
    }

    .daily-agenda .stat-waiting .stat-icon {
        background: #f2eaff;
        color: #8654bd;
    }

    .daily-agenda .stat-value {
        display: block;
        color: #304966;
        font-size: 1.35rem;
        font-weight: 800;
        line-height: 1.2;
    }

    .daily-agenda .stat-label {
        display: block;
        margin-top: 3px;
        color: #8492a6;
        font-size: .76rem;
        font-weight: 600;
    }

    /* SECTION */

    .daily-agenda .agenda-section {
        margin-bottom: 13px;
    }

    .daily-agenda .section-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-bottom: 13px;
    }

    .daily-agenda .section-heading h5 {
        margin: 0;
        color: #304966;
        font-size: 1rem;
        font-weight: 750;
    }

    .daily-agenda .section-count {
        padding: 5px 10px;
        border-radius: 20px;
        background: #edf3ff;
        color: #2868d7;
        font-size: .73rem;
        font-weight: 700;
    }

    /* PROFESSIONAL CARD */

    .daily-agenda .professional-card {
        overflow: hidden;
        margin-bottom: 15px;
        background: white;
        border: 1px solid #e7edf5;
        border-radius: 12px;
        box-shadow: 0 2px 9px rgba(35, 59, 92, .035);
    }

    .daily-agenda .professional-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 14px 17px;
        background: #fbfcfe;
        border-bottom: 1px solid #edf1f6;
    }

    .daily-agenda .professional-info {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }

    .daily-agenda .professional-avatar {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 39px;
        height: 39px;
        border-radius: 50%;
        background: #eaf1ff;
        color: #2868d7;
        font-size: .82rem;
        font-weight: 800;
    }

    .daily-agenda .professional-name {
        color: #304966;
        font-size: .87rem;
        font-weight: 750;
    }

    .daily-agenda .professional-specialty {
        margin-top: 3px;
        color: #8996a9;
        font-size: .74rem;
    }

    .daily-agenda .professional-count {
        padding: 5px 9px;
        border-radius: 7px;
        background: #edf3ff;
        color: #2868d7;
        font-size: .73rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .daily-agenda .agenda-content {
        padding: 15px 17px;
    }

    /* APPOINTMENTS */

    .daily-agenda .subsection-title {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 10px;
        color: #718198;
        font-size: .72rem;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .045em;
    }

    .daily-agenda .appointment-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 17px;
    }

    .daily-agenda .appointment-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 11px 13px;
        border: 1px solid #edf1f6;
        border-left: 3px solid #a9c4f5;
        border-radius: 8px;
        background: #fff;
        transition: .15s;
    }

    .daily-agenda .appointment-item:hover {
        background: #fafcff;
        border-color: #dce6f5;
    }

    .daily-agenda .appointment-main {
        display: flex;
        align-items: center;
        gap: 15px;
        min-width: 0;
    }

    .daily-agenda .appointment-time {
        min-width: 112px;
        color: #2868d7;
        font-size: .8rem;
        font-weight: 750;
        white-space: nowrap;
    }

    .daily-agenda .appointment-patient {
        min-width: 0;
    }

    .daily-agenda .patient-name {
        color: #304966;
        font-size: .83rem;
        font-weight: 750;
    }

    .daily-agenda .patient-document {
        margin-top: 3px;
        color: #8996a9;
        font-size: .73rem;
    }

    .daily-agenda .appointment-meta {
        display: flex;
        align-items: center;
        justify-content: end;
        gap: 9px;
        flex-wrap: wrap;
    }

    /* STATUS */

    .daily-agenda .status {
        display: inline-flex;
        align-items: center;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: .7rem;
        font-weight: 750;
        white-space: nowrap;
    }

    .daily-agenda .status-pending {
        color: #95620d;
        background: #fff3d7;
    }

    .daily-agenda .status-confirmed {
        color: #2059ac;
        background: #e4efff;
    }

    .daily-agenda .status-waiting {
        color: #8052b4;
        background: #f0e8ff;
    }

    .daily-agenda .status-completed {
        color: #176e44;
        background: #ddf7e9;
    }

    .daily-agenda .status-cancelled {
        color: #a83e51;
        background: #ffe7eb;
    }

    .daily-agenda .status-noshow {
        color: #46566d;
        background: #e9edf3;
    }

    .daily-agenda .status-default {
        color: #536987;
        background: #edf1f7;
    }

    .daily-agenda .btn-history {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 31px;
        height: 31px;
        border: 1px solid #e3eaf3;
        border-radius: 7px;
        background: white;
        color: #7186a3;
        text-decoration: none;
        transition: .2s;
    }

    .daily-agenda .btn-history:hover {
        background: #edf3ff;
        color: #2868d7;
        border-color: #cbdaf5;
    }

    /* AVAILABLE SLOTS */

    .daily-agenda .available-section {
        padding-top: 13px;
        border-top: 1px solid #edf1f6;
    }

    .daily-agenda .available-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
    }

    .daily-agenda .available-heading .subsection-title {
        margin: 0;
    }

    .daily-agenda .available-count {
        color: #26915e;
        font-size: .72rem;
        font-weight: 700;
    }

    .daily-agenda .available-list {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
    }

    .daily-agenda .available-slot {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border: 1px solid #ccebd9;
        border-radius: 7px;
        background: #f3fbf6;
        color: #218052;
        font-size: .75rem;
        font-weight: 700;
        text-decoration: none;
        transition: .2s;
    }

    .daily-agenda .available-slot:hover {
        background: #e3f7eb;
        border-color: #a4ddbd;
        color: #17633e;
        transform: translateY(-1px);
    }

    /* EMPTY STATES */

    .daily-agenda .empty-message {
        padding: 12px;
        margin-bottom: 14px;
        border-radius: 8px;
        background: #f7f9fc;
        color: #8996a9;
        font-size: .79rem;
    }

    .daily-agenda .empty-state {
        padding: 40px 20px;
        text-align: center;
        background: white;
        border: 1px dashed #dce5f0;
        border-radius: 11px;
    }

    .daily-agenda .empty-state i {
        display: block;
        margin-bottom: 12px;
        color: #a9bad2;
        font-size: 2.3rem;
    }

    .daily-agenda .empty-state h5 {
        margin-bottom: 5px;
        color: #405b80;
        font-size: .95rem;
        font-weight: 750;
    }

    .daily-agenda .empty-state p {
        margin: 0;
        color: #8996a9;
        font-size: .81rem;
    }

    /* RESPONSIVE */

    @@media (max-width: 1000px) {
        .daily-agenda .stats-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .daily-agenda .toolbar {
            align-items: flex-start;
        }

        .daily-agenda .filters {
            width: 100%;
        }

        .daily-agenda .filter-group {
            flex: 1;
        }
    }

    @@media (max-width: 600px) {
        .daily-agenda {
            padding-top: 5px;
        }

        .daily-agenda .page-heading {
            align-items: flex-start;
        }

        .daily-agenda .btn-create {
            width: 100%;
            justify-content: center;
        }

        .daily-agenda .toolbar {
            padding: 14px;
        }

        .daily-agenda .date-navigation {
            width: 100%;
        }

        .daily-agenda .date-title {
            font-size: .9rem;
        }

        .daily-agenda .filters {
            flex-direction: column;
            align-items: stretch;
        }

        .daily-agenda .filter-group {
            width: 100%;
        }

        .daily-agenda .btn-filter {
            width: 100%;
        }

        .daily-agenda .stats-grid {
            gap: 8px;
        }

        .daily-agenda .stat-card {
            gap: 8px;
            padding: 11px 9px;
        }

        .daily-agenda .stat-icon {
            width: 34px;
            height: 34px;
            font-size: .95rem;
        }

        .daily-agenda .stat-value {
            font-size: 1.1rem;
        }

        .daily-agenda .stat-label {
            font-size: .67rem;
        }

        .daily-agenda .professional-header {
            padding: 12px;
        }

        .daily-agenda .agenda-content {
            padding: 12px;
        }

        .daily-agenda .appointment-item {
            align-items: flex-start;
            flex-direction: column;
        }

        .daily-agenda .appointment-main {
            align-items: flex-start;
            flex-direction: column;
            gap: 5px;
        }

        .daily-agenda .appointment-time {
            min-width: auto;
        }

        .daily-agenda .appointment-meta {
            width: 100%;
            justify-content: space-between;
        }
    }
</style>

<div class="daily-agenda">

    <!-- HEADER -->
    <div class="page-heading">

        <div class="heading-content">
            <div class="heading-icon">
                <i class="bi bi-calendar2-week"></i>
            </div>

            <div>
                <h2 class="page-title">Agenda diaria</h2>
                <p class="page-subtitle">
                    Gestión de turnos y disponibilidad de profesionales.
                </p>
            </div>
        </div>

        <a asp-area="Reception"
           asp-controller="Appointments"
           asp-action="Create"
           class="btn-create">
            <i class="bi bi-plus-lg"></i>
            Asignar turno
        </a>

    </div>

    <!-- DATE AND FILTERS -->
    <div class="toolbar">

        <div class="date-navigation">

            <div class="date-info">
                <span class="date-label">Fecha seleccionada</span>

                <h4 class="date-title">
                    @Model.SelectedDate.ToString("dddd dd 'de' MMMM 'de' yyyy")
                </h4>
            </div>

            <div class="date-actions">

                <a asp-action="Index"
                   asp-route-date="@previousDate.ToString("yyyy-MM-dd")"
                   asp-route-professionalId="@Model.SelectedProfessionalId"
                   class="date-button"
                   title="Día anterior">
                    <i class="bi bi-chevron-left"></i>
                </a>

                <a asp-action="Index"
                   asp-route-date="@today.ToString("yyyy-MM-dd")"
                   asp-route-professionalId="@Model.SelectedProfessionalId"
                   class="date-button today">
                    Hoy
                </a>

                <a asp-action="Index"
                   asp-route-date="@nextDate.ToString("yyyy-MM-dd")"
                   asp-route-professionalId="@Model.SelectedProfessionalId"
                   class="date-button"
                   title="Día siguiente">
                    <i class="bi bi-chevron-right"></i>
                </a>

            </div>

        </div>

        <form asp-area="Reception"
              asp-controller="Agenda"
              asp-action="Index"
              method="get"
              class="filters">

            <div class="filter-group">
                <label for="date" class="filter-label">Fecha</label>

                <input type="date"
                       id="date"
                       name="date"
                       class="form-control filter-control"
                       value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
            </div>

            <div class="filter-group">
                <label for="professionalId" class="filter-label">
                    Profesional
                </label>

                <select id="professionalId"
                        name="professionalId"
                        class="form-select filter-control">

                    <option value="">Todos los profesionales</option>

                    @foreach (var professional in Model.Professionals)
                    {
                        <option value="@professional.Id"
                                selected="@(Model.SelectedProfessionalId == professional.Id)">
                            @professional.FullName - @professional.SpecialtyName
                        </option>
                    }

                </select>
            </div>

            <button type="submit" class="btn-filter">
                <i class="bi bi-funnel me-1"></i>
                Filtrar
            </button>

        </form>

    </div>

    <!-- STATISTICS -->
    <div class="stats-grid">

        <div class="stat-card stat-total">
            <div class="stat-icon">
                <i class="bi bi-calendar-check"></i>
            </div>

            <div>
                <span class="stat-value">@totalAppointments</span>
                <span class="stat-label">Total de turnos</span>
            </div>
        </div>

        <div class="stat-card stat-pending">
            <div class="stat-icon">
                <i class="bi bi-clock"></i>
            </div>

            <div>
                <span class="stat-value">@pendingAppointments</span>
                <span class="stat-label">Pendientes</span>
            </div>
        </div>

        <div class="stat-card stat-confirmed">
            <div class="stat-icon">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>
                <span class="stat-value">@confirmedAppointments</span>
                <span class="stat-label">Confirmados</span>
            </div>
        </div>

        <div class="stat-card stat-waiting">
            <div class="stat-icon">
                <i class="bi bi-hourglass-split"></i>
            </div>

            <div>
                <span class="stat-value">@waitingAppointments</span>
                <span class="stat-label">En espera</span>
            </div>
        </div>

    </div>

    <!-- AGENDA -->
    <div class="agenda-section">

        <div class="section-heading">
            <h5>
                <i class="bi bi-list-ul text-primary me-2"></i>
                Agenda de profesionales
            </h5>

            <span class="section-count">
                @Model.Professionals.Count() profesionales
            </span>
        </div>

        @if (!Model.Professionals.Any())
        {
            <div class="empty-state">
                <i class="bi bi-person-x"></i>
                <h5>No hay profesionales disponibles</h5>
                <p>No se encontraron profesionales activos para mostrar.</p>
            </div>
        }
        else
        {
            @foreach (var professional in Model.Professionals)
            {
                var professionalAppointments = appointments
                    .Where(a => a.ProfessionalId == professional.Id)
                    .OrderBy(a => a.StartTime)
                    .ToList();

                var slots = Model.AvailableSlots
                    .Where(s => s.ProfessionalId == professional.Id)
                    .OrderBy(s => s.StartTime)
                    .ToList();

                var nameParts = professional.FullName
                    .Split(' ', StringSplitOptions.RemoveEmptyEntries);

                var firstInitial = nameParts.Length > 0
                    ? nameParts[0][..1]
                    : "";

                var secondInitial = nameParts.Length > 1
                    ? nameParts[^1][..1]
                    : "";

                <div class="professional-card">

                    <!-- PROFESSIONAL HEADER -->
                    <div class="professional-header">

                        <div class="professional-info">

                            <div class="professional-avatar">
                                @firstInitial@secondInitial
                            </div>

                            <div>
                                <div class="professional-name">
                                    @professional.FullName
                                </div>

                                <div class="professional-specialty">
                                    @professional.SpecialtyName
                                </div>
                            </div>

                        </div>

                        <span class="professional-count">
                            @professionalAppointments.Count turnos
                        </span>

                    </div>

                    <div class="agenda-content">

                        <!-- APPOINTMENTS -->
                        <div class="subsection-title">
                            <i class="bi bi-calendar2-check"></i>
                            Turnos asignados
                        </div>

                        @if (professionalAppointments.Any())
                        {
                            <div class="appointment-list">

                                @foreach (var appointment in professionalAppointments)
                                {
                                    <div class="appointment-item">

                                        <div class="appointment-main">

                                            <div class="appointment-time">
                                                <i class="bi bi-clock me-1"></i>
                                                @appointment.StartTime.ToString("HH:mm")
                                                -
                                                @appointment.EndTime.ToString("HH:mm")
                                            </div>

                                            <div class="appointment-patient">

                                                <div class="patient-name">
                                                    @appointment.PatientName
                                                </div>

                                                <div class="patient-document">
                                                    DNI: @appointment.PatientDocument
                                                </div>

                                            </div>

                                        </div>

                                        <div class="appointment-meta">

                                            <span class="status @GetStatusClass(appointment.Status)">
                                                @GetStatusText(appointment.Status)
                                            </span>

                                            <a asp-area="Reception"
                                               asp-controller="Appointments"
                                               asp-action="History"
                                               asp-route-id="@appointment.Id"
                                               class="btn-history"
                                               title="Ver historial del turno">
                                                <i class="bi bi-clock-history"></i>
                                            </a>

                                        </div>

                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <div class="empty-message">
                                <i class="bi bi-calendar-check me-2"></i>
                                No hay turnos asignados para este día.
                            </div>
                        }

                        <!-- AVAILABLE SLOTS -->
                        <div class="available-section">

                            <div class="available-heading">

                                <div class="subsection-title">
                                    <i class="bi bi-calendar-plus"></i>
                                    Horarios disponibles
                                </div>

                                <span class="available-count">
                                    @slots.Count disponibles
                                </span>

                            </div>

                            @if (slots.Any())
                            {
                                <div class="available-list">

                                    @foreach (var slot in slots)
                                    {
                                        <a asp-area="Reception"
                                           asp-controller="Appointments"
                                           asp-action="Create"
                                           asp-route-professionalId="@slot.ProfessionalId"
                                           asp-route-appointmentDate="@Model.SelectedDate.ToString("yyyy-MM-dd")"
                                           asp-route-startTime="@slot.StartTime.ToString("HH:mm")"
                                           class="available-slot"
                                           title="Asignar turno en este horario">

                                            <i class="bi bi-plus-circle"></i>

                                            @slot.StartTime.ToString("HH:mm")
                                            -
                                            @slot.EndTime.ToString("HH:mm")

                                        </a>
                                    }

                                </div>
                            }
                            else
                            {
                                <div class="empty-message mb-0">
                                    <i class="bi bi-info-circle me-2"></i>
                                    No hay horarios disponibles para este profesional.
                                </div>
                            }

                        </div>

                    </div>

                </div>
            }
        }

    </div>

</div>
