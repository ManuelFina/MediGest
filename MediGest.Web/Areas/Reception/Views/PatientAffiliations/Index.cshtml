
@model MediGest.Web.ViewModels.PatientAffiliations.PatientAffiliationListViewModel
@using MediGest.Web.Models.Enums

@{
    ViewData["Title"] = "Afiliaciones del paciente";
}

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Afiliaciones</h2>
            <p class="text-muted mb-0">
                Coberturas médicas asociadas al paciente.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-area="Reception"
               asp-controller="Patients"
               asp-action="Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>
                Volver a pacientes
            </a>

            <a asp-action="Create"
               asp-route-patientId="@Model.PatientId"
               class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>
                Nueva afiliación
            </a>
        </div>
    </div>

    <!-- Información del paciente -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center"
                     style="width: 52px; height: 52px;">
                    <i class="bi bi-person fs-4"></i>
                </div>

                <div>
                    <h5 class="fw-bold mb-1">@Model.PatientName</h5>
                    <span class="text-muted">
                        Documento: @Model.DocumentNumber
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Indicadores -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="text-muted small">Total de afiliaciones</div>
                    <h3 class="fw-bold mb-0">@Model.TotalAffiliations</h3>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="text-muted small">Afiliaciones activas</div>
                    <h3 class="fw-bold text-success mb-0">
                        @Model.ActiveAffiliations
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Mensajes -->
    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-circle-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tabla de afiliaciones -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white py-3 px-4">
            <h5 class="fw-bold mb-0">Historial de coberturas</h5>
        </div>

        <div class="card-body p-0">
            @if (!Model.Affiliations.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-shield-x display-4 text-muted"></i>
                    <h5 class="mt-3">Sin afiliaciones registradas</h5>
                    <p class="text-muted">
                        Este paciente todavía no tiene coberturas médicas asociadas.
                    </p>

                    <a asp-action="Create"
                       asp-route-patientId="@Model.PatientId"
                       class="btn btn-primary">
                        Registrar primera afiliación
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 affiliation-table">
                        <thead class="table-light">
                            <tr>
                                <th>Cobertura</th>
                                <th>Plan</th>
                                <th>N.º afiliado</th>
                                <th>Beneficiario</th>
                                <th>Vigencia</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var affiliation in Model.Affiliations)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">
                                            @affiliation.HealthInsurance.Name
                                        </div>

                                        @if (affiliation.IsPrimary)
                                        {
                                            <span class="badge bg-primary-subtle text-primary">
                                                Principal
                                            </span>
                                        }
                                    </td>

                                    <td>@affiliation.HealthPlan.Name</td>

                                    <td>@affiliation.MembershipNumber</td>

                                    <td>
                                        @(affiliation.MemberType switch
                                        {
                                            PatientMemberType.Holder => "Titular",
                                            PatientMemberType.Spouse => "Cónyuge",
                                            PatientMemberType.Child => "Hijo/a",
                                            PatientMemberType.Other => "Otro beneficiario",
                                            _ => "Sin especificar"
                                        })
                                    </td>

                                    <td>
                                        <div>
                                            Desde: @affiliation.ValidFrom.ToString("dd/MM/yyyy")
                                        </div>

                                        <small class="text-muted">
                                            Hasta:
                                            @(affiliation.ValidTo?.ToString("dd/MM/yyyy") ?? "Sin vencimiento")
                                        </small>
                                    </td>

                                    <td>
                                        @switch (affiliation.Status)
                                        {
                                            case PatientAffiliationStatus.Active:
                                                <span class="badge bg-success-subtle text-success">
                                                    Activa
                                                </span>
                                                break;

                                            case PatientAffiliationStatus.Suspended:
                                                <span class="badge bg-warning-subtle text-warning-emphasis">
                                                    Suspendida
                                                </span>
                                                break;

                                            case PatientAffiliationStatus.Cancelled:
                                                <span class="badge bg-danger-subtle text-danger">
                                                    Cancelada
                                                </span>
                                                break;
                                        }
                                    </td>

                                    <!-- Acciones -->

<td class="text-end">
    <div class="dropdown">
        <button class="btn btn-sm btn-outline-primary dropdown-toggle"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false">
            <i class="bi bi-gear me-1"></i>
            Acciones
        </button>

        <ul class="dropdown-menu dropdown-menu-end shadow">

            @if (affiliation.Status != PatientAffiliationStatus.Cancelled)
            {
                <li>
                    <a asp-action="Edit"
                       asp-route-patientId="@Model.PatientId"
                       asp-route-id="@affiliation.Id"
                       class="dropdown-item">
                        <i class="bi bi-pencil-square me-2 text-primary"></i>
                        Editar
                    </a>
                </li>
            }

            @if (affiliation.Status == PatientAffiliationStatus.Active)
            {
                <li>
                    <form asp-action="Suspend"
                          asp-route-patientId="@Model.PatientId"
                          asp-route-id="@affiliation.Id"
                          method="post">
                        @Html.AntiForgeryToken()

                        <button type="submit" class="dropdown-item">
                            <i class="bi bi-pause-circle me-2 text-warning"></i>
                            Suspender
                        </button>
                    </form>
                </li>
            }
            else if (affiliation.Status == PatientAffiliationStatus.Suspended)
            {
                <li>
                    <form asp-action="Reactivate"
                          asp-route-patientId="@Model.PatientId"
                          asp-route-id="@affiliation.Id"
                          method="post">
                        @Html.AntiForgeryToken()

                        <button type="submit" class="dropdown-item">
                            <i class="bi bi-arrow-clockwise me-2 text-success"></i>
                            Reactivar
                        </button>
                    </form>
                </li>
            }

            @if (affiliation.Status != PatientAffiliationStatus.Cancelled)
            {
                <li><hr class="dropdown-divider"></li>

                <li>
                    <form asp-action="Cancel"
                          asp-route-patientId="@Model.PatientId"
                          asp-route-id="@affiliation.Id"
                          method="post">
                        @Html.AntiForgeryToken()

                        <button type="submit" class="dropdown-item text-danger">
                            <i class="bi bi-x-circle me-2"></i>
                            Cancelar afiliación
                        </button>
                    </form>
                </li>
            }

        </ul>
    </div>
</td>

                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .affiliation-table thead th {
        white-space: nowrap;
        font-size: .8rem;
        color: #64748b;
        font-weight: 700;
        padding: 1rem;
    }

    .affiliation-table tbody td {
        padding: 1rem;
        vertical-align: middle;
    }

    .affiliation-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .affiliation-actions {
        white-space: nowrap;
    }

    .affiliation-actions form {
        margin: 0;
        padding: 0;
    }

    .affiliation-actions .btn {
        width: 34px;
        height: 34px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
    }

    .affiliation-actions .btn:hover {
        transform: translateY(-1px);
    }
</style>
