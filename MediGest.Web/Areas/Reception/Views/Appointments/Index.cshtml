
@using MediGest.Web.Models.Enums
@model MediGest.Web.ViewModels.Appointments.AppointmentCalendarViewModel

@{
    ViewData["Title"] = "Agenda de turnos";

    var previousWeek = Model.SelectedDate.AddDays(-7);
    var nextWeek = Model.SelectedDate.AddDays(7);
    var today = DateOnly.FromDateTime(DateTime.Today);

    var weekDayNames = new[]
    {
        "LUN", "MAR", "MIÉ", "JUE", "VIE", "SÁB", "DOM"
    };

    var halfHourRows = (Model.EndHour - Model.StartHour) * 2;
    var trackHeight = halfHourRows * 45;
}

<style>
    .medigest-calendar {
        color: #263b59;
        padding: 8px 0 25px;
    }

    .medigest-calendar .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 25px;
    }

    .medigest-calendar .heading-title {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .medigest-calendar .heading-icon {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf2ff;
        color: #2674ed;
        border-radius: 14px;
        font-size: 1.6rem;
    }

    .medigest-calendar h2 {
        color: #263b59;
        font-size: 1.55rem;
        font-weight: 750;
        margin: 0;
    }

    .medigest-calendar .heading-subtitle {
        color: #7b8ba5;
        margin: 5px 0 0;
        font-size: .88rem;
    }

    .medigest-calendar .heading-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .medigest-calendar .action-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 14px;
        border-radius: 9px;
        border: 1px solid #e2e9f2;
        background: #fff;
        color: #526783;
        text-decoration: none;
        font-size: .82rem;
        font-weight: 600;
        transition: .2s;
    }

    .medigest-calendar .action-button:hover {
        background: #f5f8ff;
        border-color: #cbdcf8;
        color: #2674ed;
    }

    /* Calendario a ancho completo */
    .medigest-calendar .calendar-layout {
        display: block;
        width: 100%;
    }

    .medigest-calendar .calendar-main {
        width: 100%;
        min-width: 0;
    }

    .medigest-calendar .calendar-card,
    .medigest-calendar .legend-card {
        background: #fff;
        border: 1px solid #e8edf4;
        border-radius: 13px;
        box-shadow: 0 3px 12px rgba(35, 57, 88, .045);
    }

    .medigest-calendar .calendar-card {
        overflow: hidden;
    }

    .medigest-calendar .week-toolbar {
        min-height: 65px;
        padding: 14px 19px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border-bottom: 1px solid #edf0f5;
        flex-wrap: wrap;
    }

    .medigest-calendar .week-title {
        color: #344b6b;
        font-size: .91rem;
        font-weight: 700;
    }

    .medigest-calendar .week-navigation {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .medigest-calendar .week-navigation a {
        width: 33px;
        height: 33px;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 8px;
        background: #f5f7fb;
        color: #526783;
        text-decoration: none;
        font-size: .9rem;
        transition: .2s;
    }

    .medigest-calendar .week-navigation a:hover {
        background: #eaf2ff;
        color: #2674ed;
    }

    .medigest-calendar .calendar-scroll {
        overflow-x: auto;
        overflow-y: hidden;
    }

    .medigest-calendar .calendar-grid {
        min-width: 850px;
        display: grid;
        grid-template-columns: 62px repeat(7, minmax(0, 1fr));
    }

    .medigest-calendar .day-header {
        min-height: 65px;
        text-align: center;
        padding: 11px 3px;
        border-bottom: 1px solid #edf0f5;
        border-left: 1px solid #edf0f5;
        background: #fff;
    }

    .medigest-calendar .day-header .day-name {
        color: #96a4b7;
        font-size: .66rem;
        font-weight: 750;
    }

    .medigest-calendar .day-header .day-number {
        color: #344b6b;
        font-size: .98rem;
        font-weight: 750;
        margin-top: 4px;
    }

    .medigest-calendar .day-header.selected {
        background: #f1f6ff;
    }

    .medigest-calendar .day-header.selected .day-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 27px;
        height: 27px;
        border-radius: 8px;
        background: #2674ed;
        color: white;
    }

    .medigest-calendar .day-header.today:not(.selected) .day-number {
        color: #2674ed;
    }

    .medigest-calendar .time-axis {
        height: @(trackHeight)px;
        display: grid;
        grid-template-rows: repeat(@(halfHourRows), 45px);
    }

    .medigest-calendar .time-label {
        color: #96a4b7;
        font-size: .67rem;
        text-align: right;
        padding-right: 8px;
        transform: translateY(-7px);
    }

    .medigest-calendar .day-track {
        height: @(trackHeight)px;
        position: relative;
        border-left: 1px solid #edf0f5;
        background-image: repeating-linear-gradient(
            to bottom,
            transparent 0,
            transparent 44px,
            #edf0f5 44px,
            #edf0f5 45px
        );
    }

    /* Turnos */
    .medigest-calendar .calendar-event {
        position: absolute;
        left: 3px;
        right: 3px;
        min-height: 32px;
        padding: 6px;
        border-radius: 6px;
        overflow: hidden;
        z-index: 2;
        font-size: .67rem;
        line-height: 1.3;
        border-left: 3px solid;
        cursor: default;
    }

    .medigest-calendar .calendar-event strong {
        display: block;
        font-size: .69rem;
        font-weight: 750;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .medigest-calendar .calendar-event small {
        display: block;
        font-size: .63rem;
        margin-top: 3px;
    }

    .medigest-calendar .event-pending {
        background: #fff7e6;
        border-color: #e9a326;
        color: #95620d;
    }

    .medigest-calendar .event-confirmed {
        background: #edf4ff;
        border-color: #4385f5;
        color: #245da9;
    }

    .medigest-calendar .event-waiting {
        background: #e8f8fc;
        border-color: #20a5c4;
        color: #08728b;
    }

    .medigest-calendar .event-cancelled {
        background: #fff0f1;
        border-color: #e66b7d;
        color: #a83e51;
    }

    .medigest-calendar .event-completed {
        background: #eaf8f0;
        border-color: #35a970;
        color: #176e44;
    }

    .medigest-calendar .event-absent {
        background: #f0f2f5;
        border-color: #8292a9;
        color: #46566d;
    }

    /* Referencias */
    .medigest-calendar .legend-card {
        margin-top: 14px;
        padding: 14px 18px;
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
    }

    .medigest-calendar .legend-item {
        display: flex;
        align-items: center;
        gap: 7px;
        color: #73839b;
        font-size: .76rem;
    }

    .medigest-calendar .legend-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
    }

    @@media (max-width: 560px) {
        .medigest-calendar .page-heading {
            align-items: flex-start;
        }

        .medigest-calendar .heading-actions {
            width: 100%;
        }

        .medigest-calendar .action-button {
            flex: 1;
        }

        .medigest-calendar .week-toolbar {
            align-items: flex-start;
        }
    }
</style>

<div class="medigest-calendar">

    <!-- ENCABEZADO -->
    <div class="page-heading">
        <div class="heading-title">
            <div class="heading-icon">
                <i class="bi bi-calendar-week"></i>
            </div>

            <div>
                <h2>Agenda de turnos</h2>
                <p class="heading-subtitle">
                    Consulta de turnos y disponibilidad del consultorio.
                </p>
            </div>
        </div>

        <div class="heading-actions">
            <a asp-action="Index"
               asp-route-date="@today.ToString("yyyy-MM-dd")"
               class="action-button">
                <i class="bi bi-calendar-check"></i>
                Hoy
            </a>

            <a asp-action="Index"
               asp-route-date="@previousWeek.ToString("yyyy-MM-dd")"
               class="action-button">
                <i class="bi bi-chevron-left"></i>
                Semana anterior
            </a>

            <a asp-action="Index"
               asp-route-date="@nextWeek.ToString("yyyy-MM-dd")"
               class="action-button">
                <i class="bi bi-chevron-right"></i>
                Semana siguiente
            </a>
        </div>
    </div>

    <!-- CALENDARIO -->
    <div class="calendar-layout">
        <main class="calendar-main">

            <div class="calendar-card">

                <div class="week-toolbar">
                    <div class="week-title">
                        <i class="bi bi-calendar3 me-2 text-primary"></i>
                        @Model.WeekStartDate.ToString("dd/MM/yyyy")
                        -
                        @Model.WeekEndDate.ToString("dd/MM/yyyy")
                    </div>

                    <div class="week-navigation">
                        <a asp-action="Index"
                           asp-route-date="@previousWeek.ToString("yyyy-MM-dd")"
                           title="Semana anterior">
                            <i class="bi bi-chevron-left"></i>
                        </a>

                        <a asp-action="Index"
                           asp-route-date="@today.ToString("yyyy-MM-dd")"
                           title="Ir a hoy">
                            <i class="bi bi-calendar-day"></i>
                        </a>

                        <a asp-action="Index"
                           asp-route-date="@nextWeek.ToString("yyyy-MM-dd")"
                           title="Semana siguiente">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                </div>

                <div class="calendar-scroll">
                    <div class="calendar-grid">

                        <!-- ENCABEZADO DE HORA -->
                        <div class="day-header">
                            <div class="day-name">HORA</div>
                        </div>

                        <!-- DÍAS -->
                        @for (var i = 0; i < Model.WeekDays.Count(); i++)
                        {
                            var day = Model.WeekDays.ElementAt(i);
                            var headerClass = "day-header";

                            if (day == Model.SelectedDate)
                            {
                                headerClass += " selected";
                            }

                            if (day == today)
                            {
                                headerClass += " today";
                            }

                            <div class="@headerClass">
                                <div class="day-name">@weekDayNames[i]</div>
                                <div class="day-number">@day.Day</div>
                            </div>
                        }

                        <!-- EJE DE HORARIOS -->
                        <div class="time-axis">
                            @for (var i = 0; i < halfHourRows; i++)
                            {
                                if (i % 2 == 0)
                                {
                                    <div class="time-label">
                                        @(TimeOnly.FromTimeSpan(
                                            TimeSpan.FromHours(Model.StartHour + i / 2))
                                            .ToString("HH:mm"))
                                    </div>
                                }
                                else
                                {
                                    <div></div>
                                }
                            }
                        </div>

                        <!-- COLUMNAS DE DÍAS -->
                        @foreach (var day in Model.WeekDays)
                        {
                            <div class="day-track">

                                @foreach (var appointment in Model.Appointments
                                    .Where(a => a.AppointmentDate == day)
                                    .OrderBy(a => a.StartTime))
                                {
                                    var startMinutes =
                                        appointment.StartTime.Hour * 60 +
                                        appointment.StartTime.Minute -
                                        Model.StartHour * 60;

                                    var durationMinutes =
                                        (appointment.EndTime.Hour * 60 +
                                         appointment.EndTime.Minute) -
                                        (appointment.StartTime.Hour * 60 +
                                         appointment.StartTime.Minute);

                                    var top = startMinutes * 45.0 / 30.0;

                                    var height = Math.Max(
                                        32,
                                        durationMinutes * 45.0 / 30.0 - 4);

                                    var eventClass = appointment.Status switch
                                    {
                                        AppointmentStatus.Pending => "event-pending",
                                        AppointmentStatus.Confirmed => "event-confirmed",
                                        AppointmentStatus.Waiting => "event-waiting",
                                        AppointmentStatus.Cancelled => "event-cancelled",
                                        AppointmentStatus.Completed => "event-completed",
                                        AppointmentStatus.NoShow => "event-absent",
                                        _ => "event-confirmed"
                                    };

                                    <div class="calendar-event @eventClass"
                                         style="top:@(top)px; height:@(height)px;"
                                         title="@appointment.Patient.LastName, @appointment.Patient.FirstName">

                                        <strong>
                                            @appointment.Patient.LastName,
                                            @appointment.Patient.FirstName
                                        </strong>

                                        <small>
                                            @appointment.StartTime.ToString("HH:mm")
                                            -
                                            @appointment.EndTime.ToString("HH:mm")
                                        </small>

                                    </div>
                                }

                            </div>
                        }

                    </div>
                </div>
            </div>

            <!-- REFERENCIAS -->
            <div class="legend-card">
                <span class="legend-item">
                    <span class="legend-dot" style="background:#e9a326;"></span>
                    Pendiente
                </span>

                <span class="legend-item">
                    <span class="legend-dot" style="background:#4385f5;"></span>
                    Confirmado
                </span>

                <span class="legend-item">
                    <span class="legend-dot" style="background:#20a5c4;"></span>
                    En espera
                </span>

                <span class="legend-item">
                    <span class="legend-dot" style="background:#e66b7d;"></span>
                    Cancelado
                </span>

                <span class="legend-item">
                    <span class="legend-dot" style="background:#35a970;"></span>
                    Completado
                </span>

                <span class="legend-item">
                    <span class="legend-dot" style="background:#8292a9;"></span>
                    Ausente
                </span>
            </div>

        </main>
    </div>
</div>
