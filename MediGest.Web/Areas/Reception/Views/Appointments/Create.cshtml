@model MediGest.Web.ViewModels.Appointments.AppointmentFormViewModel

@{
    ViewData["Title"] = "Asignar turno";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2>Asignar turno</h2>
            <p class="text-muted">
                Seleccioná un paciente, profesional y horario disponible.
            </p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="PatientId"
                               class="form-label"></label>

                        <select asp-for="PatientId"
                                asp-items="Model.AvailablePatients"
                                class="form-select">
                            <option value="">Seleccionar paciente</option>
                        </select>

                        <span asp-validation-for="PatientId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ProfessionalId"
                               class="form-label"></label>

                        <select asp-for="ProfessionalId"
                                asp-items="Model.AvailableProfessionals"
                                class="form-select"
                                id="professionalSelect">
                            <option value="">Seleccionar profesional</option>
                        </select>

                        <span asp-validation-for="ProfessionalId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AppointmentDate"
                               class="form-label"></label>

                        <input asp-for="AppointmentDate"
                               type="date"
                               class="form-control"
                               id="appointmentDate" />

                        <span asp-validation-for="AppointmentDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="StartTime"
                               class="form-label"></label>

                        <select asp-for="StartTime"
                                asp-items="Model.AvailableSlots"
                                class="form-select"
                                id="availableSlots">
                            <option value="">Seleccionar horario</option>
                        </select>

                        <span asp-validation-for="StartTime"
                              class="text-danger"></span>

                        <small class="text-muted" id="availabilityMessage">
                            Seleccioná un profesional y una fecha.
                        </small>
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="Notes"
                               class="form-label"></label>

                        <textarea asp-for="Notes"
                                  class="form-control"
                                  rows="3"></textarea>

                        <span asp-validation-for="Notes"
                              class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Asignar turno
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const professionalSelect =
                document.getElementById("professionalSelect");

            const appointmentDate =
                document.getElementById("appointmentDate");

            const availableSlots =
                document.getElementById("availableSlots");

            const availabilityMessage =
                document.getElementById("availabilityMessage");

            async function loadAvailableSlots() {
                const professionalId = professionalSelect.value;
                const date = appointmentDate.value;

                availableSlots.innerHTML =
                    '<option value="">Seleccionar horario</option>';

                if (!professionalId || !date) {
                    availabilityMessage.textContent =
                        "Seleccioná un profesional y una fecha.";
                    return;
                }

                availabilityMessage.textContent =
                    "Consultando disponibilidad...";

                try {
                    const url =
                        '@Url.Action("GetAvailableSlots", "Appointments", new { area = "Reception" })'
                        + '?professionalId=' + encodeURIComponent(professionalId)
                        + '&date=' + encodeURIComponent(date);

                    const response = await fetch(url);

                    if (!response.ok) {
                        throw new Error("No se pudo consultar la disponibilidad.");
                    }

                    const slots = await response.json();

                    if (slots.length === 0) {
                        availabilityMessage.textContent =
                            "No hay horarios disponibles para esta fecha.";
                        return;
                    }

                    slots.forEach(slot => {
                        const option = document.createElement("option");
                        option.value = slot.value;
                        option.textContent = slot.text;
                        availableSlots.appendChild(option);
                    });

                    availabilityMessage.textContent =
                        "Seleccioná uno de los horarios disponibles.";

                } catch (error) {
                    availabilityMessage.textContent =
                        "Ocurrió un error al consultar los horarios.";
                }
            }

            professionalSelect.addEventListener(
                "change",
                loadAvailableSlots
            );

            appointmentDate.addEventListener(
                "change",
                loadAvailableSlots
            );

            loadAvailableSlots();
        });
    </script>
}
