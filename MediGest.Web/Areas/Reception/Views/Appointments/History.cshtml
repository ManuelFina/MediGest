
@model MediGest.Web.ViewModels.Appointments.AppointmentHistoryViewModel

@{
    ViewData["Title"] = "Historial del turno";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Historial del turno</h2>
            <p class="text-muted mb-0">
                Registro de modificaciones y acciones realizadas.
            </p>
        </div>

        <a asp-action="Index"
           asp-route-date="@Model.AppointmentDate.ToString("yyyy-MM-dd")"
           class="btn btn-outline-secondary">
            Volver a turnos
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <div class="row">
                <div class="col-md-4 mb-3">
                    <small class="text-muted">Número de turno</small>
                    <h5>#@Model.AppointmentId</h5>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted">Paciente</small>
                    <h5>@Model.PatientName</h5>
                </div>

                <div class="col-md-4 mb-3">
                    <small class="text-muted">Profesional</small>
                    <h5>@Model.ProfessionalName</h5>
                </div>

                <div class="col-md-4">
                    <small class="text-muted">Fecha del turno</small>
                    <h5>@Model.AppointmentDate.ToString("dd/MM/yyyy")</h5>
                </div>
            </div>

        </div>
    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-white">
            <h5 class="mb-0">Movimientos registrados</h5>
        </div>

        <div class="card-body">

            @if (!Model.History.Any())
            {
                <div class="text-center py-5">
                    <h5>No hay movimientos registrados.</h5>
                    <p class="text-muted">
                        Todavía no se registraron modificaciones para este turno.
                    </p>
                </div>
            }
            else
            {
                <div class="list-group list-group-flush">

                    @foreach (var item in Model.History)
                    {
                        <div class="list-group-item py-3">

                            <div class="d-flex justify-content-between flex-wrap gap-2">

                                <div>
                                    <h6 class="mb-1">
                                        @item.Description
                                    </h6>

                                    <small class="text-muted">
                                        Responsable:
                                        <strong>@item.ChangedByUserName</strong>
                                    </small>
                                </div>

                                <div class="text-muted text-end">
                                    <small>
                                        @item.ChangedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                    </small>
                                    <br />
                                    <small>
                                        @item.ChangedAt.ToLocalTime().ToString("HH:mm")
                                    </small>
                                </div>

                            </div>

                        </div>
                    }

                </div>
            }

        </div>
    </div>

</div>
