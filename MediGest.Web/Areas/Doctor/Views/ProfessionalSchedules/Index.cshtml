
@model IEnumerable<MediGest.Web.Models.Entities.ProfessionalSchedule>

@{
    ViewData["Title"] = "Mis horarios";
}

<div class="container-fluid">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Mis horarios</h2>
            <p class="text-muted mb-0">
                Administrá tus agendas y períodos de atención.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Nueva agenda
        </a>
    </div>

    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="bi bi-calendar-week me-2"></i>
                Agendas configuradas
            </h5>
        </div>

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-plus display-4 text-muted"></i>

                    <h5 class="mt-3">Todavía no tenés agendas</h5>

                    <p class="text-muted">
                        Creá tu primera agenda para configurar tus días y horarios de atención.
                    </p>

                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>
                        Crear primera agenda
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th>Desde</th>
                                <th>Hasta</th>
                                <th>Duración</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var schedule in Model.OrderByDescending(s => s.StartDate))
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">
                                            @schedule.Name
                                        </span>
                                    </td>

                                    <td>
                                        @schedule.StartDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @schedule.EndDate.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @schedule.AppointmentDurationMinutes minutos
                                    </td>

                                    <td>
                                        @if (schedule.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Activa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactiva
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">

                                            <a asp-action="Edit"
                                               asp-route-id="@schedule.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Editar agenda">

                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <a asp-area="Doctor"
                                               asp-controller="ScheduleDays"
                                               asp-action="Index"
                                               asp-route-scheduleId="@schedule.Id"
                                               class="btn btn-sm btn-outline-info"
                                               title="Configurar días y horarios">

                                                <i class="bi bi-clock"></i>
                                            </a>

                                            <form asp-action="Delete"
                                                  asp-route-id="@schedule.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Eliminar agenda"
                                                        onclick="return confirm('¿Estás seguro de eliminar esta agenda?');">

                                                    <i class="bi bi-trash"></i>
                                                </button>

                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>
