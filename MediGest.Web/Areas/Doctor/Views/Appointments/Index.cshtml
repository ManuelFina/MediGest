
@model IEnumerable<MediGest.Web.Models.Entities.Appointment>

@using MediGest.Web.Models.Enums

@{
    ViewData["Title"] = "Mi agenda";

    var selectedDate = (DateOnly)ViewBag.SelectedDate;
    var professionalName = (string)ViewBag.ProfessionalName;
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Mi agenda</h2>
            <p class="text-muted mb-0">
                Bienvenido, Dr. @professionalName
            </p>
        </div>

        <form asp-action="Index" method="get" class="d-flex gap-2">
            <input
                type="date"
                name="date"
                class="form-control"
                value="@selectedDate.ToString("yyyy-MM-dd")" />

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i>
                Consultar
            </button>
        </form>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">
                Turnos del @selectedDate.ToString("dd/MM/yyyy")
            </h5>
        </div>

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x display-4 text-muted"></i>

                    <h5 class="mt-3">No hay turnos para esta fecha</h5>

                    <p class="text-muted mb-0">
                        No tenés consultas programadas para el día seleccionado.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Horario</th>
                                <th>Paciente</th>
                                <th>Documento</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var appointment in Model.OrderBy(a => a.StartTime))
                            {
                                <tr>
                                    <td>
                                        <span class="fw-semibold">
                                            @appointment.StartTime.ToString("HH:mm")
                                        </span>
                                        <span class="text-muted">
                                            - @appointment.EndTime.ToString("HH:mm")
                                        </span>
                                    </td>

                                    <td>
                                        @appointment.Patient.LastName,
                                        @appointment.Patient.FirstName
                                    </td>

                                    <td>
                                        @appointment.Patient.DocumentNumber
                                    </td>

                                    <td>
                                        @switch (appointment.Status)
                                        {
                                            case AppointmentStatus.Pending:
                                                <span class="badge bg-warning text-dark">
                                                    Pendiente
                                                </span>
                                                break;

                                            case AppointmentStatus.Confirmed:
                                                <span class="badge bg-primary">
                                                    Confirmado
                                                </span>
                                                break;

                                            case AppointmentStatus.Waiting:
                                                <span class="badge bg-info text-dark">
                                                    En espera
                                                </span>
                                                break;

                                            case AppointmentStatus.Completed:
                                                <span class="badge bg-success">
                                                    Completado
                                                </span>
                                                break;

                                            case AppointmentStatus.Cancelled:
                                                <span class="badge bg-danger">
                                                    Cancelado
                                                </span>
                                                break;

                                            case AppointmentStatus.NoShow:
                                                <span class="badge bg-secondary">
                                                    Ausente
                                                </span>
                                                break;
                                        }
                                    </td>

                                    <td class="text-end">
                                        @if (appointment.Status == AppointmentStatus.Waiting)
                                        {
                                            <form asp-action="Complete"
                                                  asp-route-id="@appointment.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-success"
                                                        onclick="return confirm('¿Confirmás que la atención fue completada?');">

                                                    <i class="bi bi-check-circle"></i>
                                                    Completar atención
                                                </button>

                                            </form>
                                        }
                                        else if (appointment.Status == AppointmentStatus.Completed)
                                        {
                                            <span class="text-success">
                                                <i class="bi bi-check-circle-fill"></i>
                                                Atención finalizada
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Sin acciones disponibles
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>
