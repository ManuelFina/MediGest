
@model IEnumerable<MediGest.Web.Models.Entities.ScheduleException>

@{
    ViewData["Title"] = "Mis excepciones de agenda";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Excepciones de agenda</h2>
            <p class="text-muted mb-0">
                Gestioná vacaciones, licencias y bloqueos de horarios.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Nueva excepción
        </a>
    </div>

    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Desde</th>
                                <th>Hasta</th>
                                <th>Horario</th>
                                <th>Motivo</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exception in Model.OrderBy(e => e.StartDate))
                            {
                                <tr>
                                    <td>
                                        @exception.StartDate.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        @exception.EndDate.ToString("dd/MM/yyyy")
                                    </td>
                                    <td>
                                        @if (exception.StartTime.HasValue && exception.EndTime.HasValue)
                                        {
                                            <span>
                                                @exception.StartTime.Value.ToString("HH:mm")
                                                -
                                                @exception.EndTime.Value.ToString("HH:mm")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Día completo
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @exception.Reason
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Edit"
                                           asp-route-id="@exception.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@exception.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('¿Estás seguro de eliminar esta excepción?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-calendar-x display-4 text-muted"></i>
                    <h5 class="mt-3">No tenés excepciones registradas</h5>
                    <p class="text-muted">
                        Podés registrar vacaciones, licencias o bloqueos de horarios.
                    </p>
                    <a asp-action="Create" class="btn btn-primary">
                        Crear excepción
                    </a>
                </div>
            }

        </div>
    </div>
</div>
