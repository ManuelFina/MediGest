
@model MediGest.Web.ViewModels.HealthPlans.HealthPlanFormViewModel

@{
    ViewData["Title"] = "Nuevo plan médico";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Nuevo plan médico</h2>
        <p class="text-muted mb-0">
            Registrá un plan perteneciente a una obra social o prepaga.
        </p>
    </div>

    @if (!Model.HealthInsurances.Any())
    {
        <div class="alert alert-warning">
            No hay coberturas activas disponibles.
            <a asp-area="Admin"
               asp-controller="HealthInsurances"
               asp-action="Create"
               class="alert-link">
                Registrá una cobertura primero.
            </a>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <partial name="_Form" model="Model" />

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@(!Model.HealthInsurances.Any())">
                        Guardar plan
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
