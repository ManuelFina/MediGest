
@model MediGest.Web.ViewModels.HealthPlans.HealthPlanFormViewModel

@{
    ViewData["Title"] = "Editar plan médico";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Editar plan médico</h2>
        <p class="text-muted mb-0">
            Modificá la información del plan seleccionado.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />

                <partial name="_Form" model="Model" />

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-primary">
                        Guardar cambios
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
