
@model MediGest.Web.ViewModels.HealthPlans.HealthPlanFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-3">

    <div class="col-md-6">
        <label asp-for="HealthInsuranceId" class="form-label"></label>
        <select asp-for="HealthInsuranceId"
                asp-items="Model.HealthInsurances"
                class="form-select">
            <option value="">Seleccionar cobertura</option>
        </select>
        <span asp-validation-for="HealthInsuranceId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description"
                  class="form-control"
                  rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="col-12">
        <div class="form-check form-switch">
            <input asp-for="RequiresAuthorization" class="form-check-input" />
            <label asp-for="RequiresAuthorization" class="form-check-label"></label>
        </div>
        <div class="form-text">
            Indicá si este plan requiere autorización previa para realizar prestaciones.
        </div>
    </div>

</div>
