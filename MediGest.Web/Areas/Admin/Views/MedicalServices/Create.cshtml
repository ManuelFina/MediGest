
@model MediGest.Web.ViewModels.MedicalServices.MedicalServiceFormViewModel

@{
    ViewData["Title"] = "Nueva prestación médica";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <a asp-area="Admin"
           asp-controller="MedicalServices"
           asp-action="Index"
           class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i>
            Volver a prestaciones
        </a>

        <h2 class="fw-bold mt-3 mb-1">
            <i class="bi bi-plus-circle text-primary me-2"></i>
            Nueva prestación médica
        </h2>

        <p class="text-muted mb-0">
            Registrá una nueva consulta, práctica o procedimiento médico.
        </p>
    </div>

    <div class="row">
        <div class="col-lg-9 col-xl-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white py-3">
                    <h5 class="fw-semibold mb-0">
                        Datos de la prestación
                    </h5>
                </div>

                <div class="card-body p-4">

                    <form asp-area="Admin"
                          asp-controller="MedicalServices"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <partial name="_MedicalServiceForm" model="Model" />

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-area="Admin"
                               asp-controller="MedicalServices"
                               asp-action="Index"
                               class="btn btn-light border">
                                Cancelar
                            </a>

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>
                                Registrar prestación
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
