
@model MediGest.Web.ViewModels.MedicalServices.MedicalServiceListViewModel

@{
    ViewData["Title"] = "Prestaciones médicas";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin/users.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin/specialties.css"
          asp-append-version="true" />
}

<div class="container-fluid admin-page">

    <!-- ENCABEZADO -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="page-title">Prestaciones médicas</h2>
            <p class="page-subtitle">
                Administrá el catálogo de consultas, prácticas y procedimientos médicos.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="MedicalServices"
           asp-action="Create"
           class="btn btn-admin-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Nueva prestación
        </a>
    </div>

    <!-- MENSAJES -->
    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ESTADÍSTICAS -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Total de prestaciones</div>
                    <div class="stat-value">@Model.TotalMedicalServices</div>
                </div>
                <div class="stat-icon stat-icon-primary">
                    <i class="bi bi-clipboard2-pulse"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Prestaciones activas</div>
                    <div class="stat-value">@Model.ActiveMedicalServices</div>
                </div>
                <div class="stat-icon stat-icon-success">
                    <i class="bi bi-check-circle"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Prestaciones inactivas</div>
                    <div class="stat-value">@Model.InactiveMedicalServices</div>
                </div>
                <div class="stat-icon stat-icon-secondary">
                    <i class="bi bi-pause-circle"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- LISTADO -->
    <div class="content-card">

        <div class="content-card-header">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h5 class="section-title mb-1">Listado de prestaciones</h5>
                    <p class="section-description mb-0">
                        Consultas, prácticas y procedimientos registrados.
                    </p>
                </div>

                <div class="specialty-search">
                    <input type="search"
                           id="medicalServiceSearch"
                           class="form-control"
                           placeholder="Buscar prestación..."
                           autocomplete="off" />

                    <button type="button"
                            id="clearMedicalServiceSearch"
                            class="btn btn-admin-light"
                            title="Limpiar búsqueda">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="content-card-body p-0">
            <div class="table-responsive">
                <table class="table users-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Prestación</th>
                            <th>Especialidad</th>
                            <th>Valor particular</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody id="medicalServicesTableBody">
                        @await Html.PartialAsync(
                            "_MedicalServiceRows",
                            Model.MedicalServices)
                    </tbody>
                </table>
            </div>
        </div>

        <div class="content-card-footer">
            <small id="medicalServiceResultsCount">
                Mostrando @Model.MedicalServices.Count() prestaciones.
            </small>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchInput = document.getElementById("medicalServiceSearch");
            const clearButton = document.getElementById("clearMedicalServiceSearch");
            const tableBody = document.getElementById("medicalServicesTableBody");
            const resultsCount = document.getElementById("medicalServiceResultsCount");

            const searchUrl = '@Url.Action("Search", "MedicalServices", new { area = "Admin" })';

            let debounceTimer;
            let abortController;

            async function searchMedicalServices() {

                const searchTerm = searchInput.value.trim();

                if (abortController) {
                    abortController.abort();
                }

                abortController = new AbortController();

                const url = new URL(searchUrl, window.location.origin);
                url.searchParams.set("searchTerm", searchTerm);

                try {
                    const response = await fetch(url, {
                        method: "GET",
                        headers: {
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        signal: abortController.signal
                    });

                    if (!response.ok) {
                        throw new Error("No se pudo realizar la búsqueda.");
                    }

                    const html = await response.text();

                    tableBody.innerHTML = html;

                    const count = response.headers.get("X-Results-Count") ?? "0";

                    resultsCount.textContent =
                        `Mostrando ${count} prestaciones.`;

                    const currentUrl = new URL(window.location.href);

                    if (searchTerm) {
                        currentUrl.searchParams.set("searchTerm", searchTerm);
                    } else {
                        currentUrl.searchParams.delete("searchTerm");
                    }

                    window.history.replaceState({}, "", currentUrl);

                } catch (error) {
                    if (error.name !== "AbortError") {
                        console.error(error);
                    }
                }
            }

            searchInput.addEventListener("input", function () {
                clearTimeout(debounceTimer);

                debounceTimer = setTimeout(
                    searchMedicalServices,
                    300
                );
            });

            clearButton.addEventListener("click", function () {
                searchInput.value = "";
                searchInput.focus();

                clearTimeout(debounceTimer);
                searchMedicalServices();
            });

        });
    </script>
}
