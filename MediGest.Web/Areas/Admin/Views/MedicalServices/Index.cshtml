
@model MediGest.Web.ViewModels.MedicalServices.MedicalServiceListViewModel

@{
    ViewData["Title"] = "Prestaciones médicas";
}

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-clipboard2-pulse text-primary me-2"></i>
                Prestaciones médicas
            </h2>
            <p class="text-muted mb-0">
                Administrá el catálogo de consultas, prácticas y procedimientos médicos.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="MedicalServices"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Nueva prestación
        </a>
    </div>

    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Indicadores -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-3 bg-primary bg-opacity-10 p-3 me-3">
                        <i class="bi bi-clipboard2-pulse fs-3 text-primary"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1">Total de prestaciones</p>
                        <h3 class="fw-bold mb-0">@Model.TotalMedicalServices</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-3 bg-success bg-opacity-10 p-3 me-3">
                        <i class="bi bi-check-circle fs-3 text-success"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1">Prestaciones activas</p>
                        <h3 class="fw-bold mb-0">@Model.ActiveMedicalServices</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-3 bg-secondary bg-opacity-10 p-3 me-3">
                        <i class="bi bi-pause-circle fs-3 text-secondary"></i>
                    </div>
                    <div>
                        <p class="text-muted mb-1">Prestaciones inactivas</p>
                        <h3 class="fw-bold mb-0">@Model.InactiveMedicalServices</h3>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Tabla -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h5 class="fw-semibold mb-0">Listado de prestaciones</h5>

                <div class="input-group" style="max-width: 320px;">
                    <span class="input-group-text bg-light border-end-0">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text"
                           id="tableSearch"
                           class="form-control border-start-0"
                           placeholder="Buscar prestación...">
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="medicalServicesTable">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Código</th>
                            <th>Prestación</th>
                            <th>Especialidad</th>
                            <th>Valor particular</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (!Model.MedicalServices.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <i class="bi bi-clipboard-x fs-1 text-muted"></i>
                                    <h6 class="fw-semibold mt-3">No hay prestaciones registradas</h6>
                                    <p class="text-muted mb-0">
                                        Registrá la primera prestación para comenzar.
                                    </p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var service in Model.MedicalServices)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <span class="text-muted">
                                            @(service.Code ?? "Sin código")
                                        </span>
                                    </td>

                                    <td>
                                        <div class="fw-semibold">@service.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(service.Description))
                                        {
                                            <small class="text-muted">
                                                @service.Description
                                            </small>
                                        }
                                    </td>

                                    <td>
                                        @(service.Specialty?.Name ?? "Sin especialidad")
                                    </td>

                                    <td class="fw-semibold">
                                        @service.PrivatePrice.ToString("C2")
                                    </td>

                                    <td>
                                        @if (service.IsActive)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success">
                                                Activa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary">
                                                Inactiva
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="d-flex justify-content-end gap-2">

                                            <a asp-area="Admin"
                                               asp-controller="MedicalServices"
                                               asp-action="Edit"
                                               asp-route-id="@service.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            @if (service.IsActive)
                                            {
                                                <form asp-area="Admin"
                                                      asp-controller="MedicalServices"
                                                      asp-action="Deactivate"
                                                      asp-route-id="@service.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('¿Desactivar esta prestación?');">

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Desactivar">
                                                        <i class="bi bi-pause-circle"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-area="Admin"
                                                      asp-controller="MedicalServices"
                                                      asp-action="Activate"
                                                      asp-route-id="@service.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('¿Activar esta prestación?');">

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success"
                                                            title="Activar">
                                                        <i class="bi bi-check-circle"></i>
                                                    </button>
                                                </form>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>

                </table>
            </div>
        </div>

        <div class="card-footer bg-white">
            <small class="text-muted">
                Total: @Model.TotalMedicalServices prestaciones registradas.
            </small>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.getElementById("tableSearch")?.addEventListener("input", function () {
            const search = this.value.toLowerCase();
            const rows = document.querySelectorAll("#medicalServicesTable tbody tr");

            rows.forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(search)
                    ? ""
                    : "none";
            });
        });
    </script>
}
