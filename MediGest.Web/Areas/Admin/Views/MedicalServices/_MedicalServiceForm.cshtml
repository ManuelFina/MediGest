
@model MediGest.Web.ViewModels.MedicalServices.MedicalServiceFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<input type="hidden" asp-for="Id" />

<div class="row g-3">

    <div class="col-md-4">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code"
               class="form-control"
               placeholder="Ej. CONS001" />
        <span asp-validation-for="Code" class="text-danger"></span>
        <small class="text-muted">Código opcional de la prestación.</small>
    </div>

    <div class="col-md-8">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name"
               class="form-control"
               placeholder="Ej. Consulta clínica general" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="SpecialtyId" class="form-label"></label>
        <select asp-for="SpecialtyId"
                asp-items="Model.Specialties"
                class="form-select">
            <option value="">Sin especialidad específica</option>
        </select>
        <span asp-validation-for="SpecialtyId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="PrivatePrice" class="form-label"></label>
        <div class="input-group">
            <span class="input-group-text">$</span>
            <input asp-for="PrivatePrice"
                   class="form-control"
                   type="number"
                   step="0.01"
                   min="0.01"
                   placeholder="15000.00" />
        </div>
        <span asp-validation-for="PrivatePrice" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description"
                  class="form-control"
                  rows="3"
                  placeholder="Descripción o detalles de la prestación..."></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

</div>
