
@model MediGest.Web.ViewModels.Professionals.ProfessionalFormViewModel

@{
    ViewData["Title"] = "Editar profesional";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Editar profesional</h2>
            <p class="text-muted mb-0">
                Modificá la matrícula profesional o su especialidad.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Professionals"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Volver
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8 col-xl-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">

                    <form asp-area="Admin"
                          asp-controller="Professionals"
                          asp-action="Edit"
                          asp-route-id="@Model.Id"
                          method="post">

                        <input asp-for="Id" type="hidden" />
                        <input asp-for="ApplicationUserId" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert"></div>

                        <div class="mb-3">
                            <label class="form-label">Profesional</label>
                            <input class="form-control"
                                   value="@Model.ApplicationUserId"
                                   disabled />
                            <div class="form-text">
                                El usuario vinculado no se puede modificar.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SpecialtyId"
                                   class="form-label"></label>

                            <select asp-for="SpecialtyId"
                                    asp-items="Model.AvailableSpecialties"
                                    class="form-select">
                                <option value="0">Seleccioná una especialidad</option>
                            </select>

                            <span asp-validation-for="SpecialtyId"
                                  class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="LicenseNumber"
                                   class="form-label"></label>

                            <input asp-for="LicenseNumber"
                                   class="form-control"
                                   placeholder="Ej. MP-12345" />

                            <span asp-validation-for="LicenseNumber"
                                  class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-area="Admin"
                               asp-controller="Professionals"
                               asp-action="Index"
                               class="btn btn-light">
                                Cancelar
                            </a>

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>
                                Guardar cambios
                            </button>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
