
@model MediGest.Web.ViewModels.Professionals.ProfessionalFormViewModel

@{
    ViewData["Title"] = "Editar profesional";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin/users.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin/professionals.css"
          asp-append-version="true" />
}

<div class="container-fluid admin-page">

    <!-- Encabezado -->
    <div class="page-header mb-4">

        <div class="mt-3">
            <h2 class="page-title mb-1">Editar profesional</h2>
            <p class="page-subtitle mb-0">
                Modificá la matrícula profesional o su especialidad.
            </p>
        </div>

    </div>

    <div class="row">
        <div class="col-lg-8 col-xl-7">

            <div class="content-card">

                <div class="content-card-header">
                    <h5 class="section-title mb-1">
                        <i class="bi bi-person-gear me-2"></i>
                        Información profesional
                    </h5>

                    <p class="section-description mb-0">
                        Actualizá los datos laborales del profesional.
                    </p>
                </div>

                <div class="p-4">

                    <form asp-area="Admin"
                          asp-controller="Professionals"
                          asp-action="Edit"
                          asp-route-id="@Model.Id"
                          method="post">

                        <input asp-for="Id" type="hidden" />
                        <input asp-for="ApplicationUserId" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger validation-summary"
                             role="alert">
                        </div>

                        <!-- Cuenta vinculada -->
                        <div class="professional-form-section">

                            <div class="form-section-heading">
                                <div class="form-section-icon">
                                    <i class="bi bi-person-check"></i>
                                </div>

                                <div>
                                    <h6 class="form-section-title">
                                        Cuenta vinculada
                                    </h6>
                                    <p class="form-section-description">
                                        Usuario asociado a esta ficha profesional.
                                    </p>
                                </div>
                            </div>

                            <div class="linked-user-box">

                                <div class="linked-user-icon">
                                    <i class="bi bi-person-vcard"></i>
                                </div>

                                <div>
                                    <strong>Cuenta de usuario</strong>
                                    <p class="mb-0">
                                        El usuario vinculado no se puede modificar desde esta sección.
                                    </p>
                                </div>

                                <span class="linked-user-badge">
                                    <i class="bi bi-lock-fill me-1"></i>
                                    Vinculado
                                </span>

                            </div>

                        </div>

                        <hr class="form-divider" />

                        <!-- Datos profesionales -->
                        <div class="professional-form-section">

                            <div class="form-section-heading">
                                <div class="form-section-icon access-icon">
                                    <i class="bi bi-clipboard2-pulse"></i>
                                </div>

                                <div>
                                    <h6 class="form-section-title">
                                        Datos profesionales
                                    </h6>
                                    <p class="form-section-description">
                                        Modificá la especialidad y matrícula habilitante.
                                    </p>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="SpecialtyId"
                                       class="form-label"></label>

                                <select asp-for="SpecialtyId"
                                        asp-items="Model.AvailableSpecialties"
                                        class="form-select">
                                    <option value="0">Seleccioná una especialidad</option>
                                </select>

                                <span asp-validation-for="SpecialtyId"
                                      class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="LicenseNumber"
                                       class="form-label"></label>

                                <input asp-for="LicenseNumber"
                                       class="form-control"
                                       placeholder="Ej. MP-12345" />

                                <span asp-validation-for="LicenseNumber"
                                      class="text-danger small"></span>
                            </div>

                        </div>

                        <!-- Información -->
                        <div class="form-info mt-4">
                            <i class="bi bi-info-circle-fill"></i>

                            <div>
                                <strong>Información sobre la cuenta</strong>
                                <p class="mb-0">
                                    Para modificar el nombre, correo electrónico o
                                    contraseña del usuario, ingresá al módulo Usuarios.
                                </p>
                            </div>
                        </div>

                        <!-- Acciones -->
                        <div class="form-actions">

                            <a asp-area="Admin"
                               asp-controller="Professionals"
                               asp-action="Index"
                               class="btn btn-admin-light">
                                Cancelar
                            </a>

                            <button type="submit" class="btn btn-admin-primary">
                                <i class="bi bi-check-lg me-1"></i>
                                Guardar cambios
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
