
@model MediGest.Web.ViewModels.Professionals.ProfessionalListViewModel

@{
    ViewData["Title"] = "Profesionales";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin/users.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin/professionals.css"
          asp-append-version="true" />
}
<div class="container-fluid admin-page">

    <!-- Encabezado -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h2 class="page-title mb-1">Profesionales</h2>
            <p class="page-subtitle mb-0">
                Administrá los médicos y sus especialidades.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Professionals"
           asp-action="Create"
           class="btn btn-admin-primary">
            <i class="bi bi-person-plus me-1"></i>
            Registrar profesional
        </a>

    </div>

    <!-- Mensajes -->
    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    <!-- Estadísticas -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="stat-card h-100">
                <div>
                    <p class="stat-label">Total de profesionales</p>
                    <h3 class="stat-value">@Model.TotalProfessionals</h3>
                </div>

                <div class="stat-icon stat-icon-primary">
                    <i class="bi bi-people"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card h-100">
                <div>
                    <p class="stat-label">Profesionales activos</p>
                    <h3 class="stat-value text-success">
                        @Model.ActiveProfessionals
                    </h3>
                </div>

                <div class="stat-icon stat-icon-success">
                    <i class="bi bi-person-check"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card h-100">
                <div>
                    <p class="stat-label">Profesionales inactivos</p>
                    <h3 class="stat-value text-secondary">
                        @Model.InactiveProfessionals
                    </h3>
                </div>

                <div class="stat-icon stat-icon-secondary">
                    <i class="bi bi-person-dash"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- Listado -->
    <div class="content-card">

        <div class="content-card-header">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div>
                    <h5 class="section-title mb-1">
                        Listado de profesionales
                    </h5>
                    <p class="section-description mb-0">
                        Consultá y administrá los profesionales registrados.
                    </p>
                </div>

                <form asp-area="Admin"
                      asp-controller="Professionals"
                      asp-action="Index"
                      method="get"
                      class="professional-search">

                    <input type="search"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           class="form-control"
                           placeholder="Buscar profesional..."
                           aria-label="Buscar profesional" />

                    <button type="submit"
                            class="btn btn-admin-primary"
                            title="Buscar">
                        <i class="bi bi-search"></i>
                    </button>

                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <a asp-area="Admin"
                           asp-controller="Professionals"
                           asp-action="Index"
                           class="btn btn-admin-light"
                           title="Limpiar búsqueda">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }

                </form>

            </div>
        </div>

        <div class="content-card-body p-0">

            @if (!Model.Professionals.Any())
            {
                <div class="empty-state">

                    <div class="empty-state-icon">
                        <i class="bi bi-person-vcard"></i>
                    </div>

                    <h5>No hay profesionales registrados</h5>

                    <p>
                        Todavía no se encontraron profesionales para mostrar.
                    </p>

                    <a asp-area="Admin"
                       asp-controller="Professionals"
                       asp-action="Create"
                       class="btn btn-admin-primary">
                        <i class="bi bi-person-plus me-1"></i>
                        Registrar primer profesional
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table users-table professionals-table mb-0">

                        <thead>
                            <tr>
                                <th class="ps-4">Profesional</th>
                                <th>Especialidad</th>
                                <th>Matrícula</th>
                                <th>Estado</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var professional in Model.Professionals)
                            {
                                <tr>

                                    <td class="ps-4">
                                        <div class="user-name">
                                            @professional.ApplicationUser.LastName,
                                            @professional.ApplicationUser.FirstName
                                        </div>

                                        <div class="user-email">
                                            @professional.ApplicationUser.Email
                                        </div>
                                    </td>

                                    <td>
                                        <span class="specialty-name">
                                            @professional.Specialty.Name
                                        </span>
                                    </td>

                                    <td>
                                        <span class="license-number">
                                            @professional.LicenseNumber
                                        </span>
                                    </td>

                                    <td>
                                        @if (professional.IsActive)
                                        {
                                            <span class="status-badge status-active">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-inactive">
                                                <i class="bi bi-dash-circle me-1"></i>
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">

                                        <div class="d-inline-flex gap-2">

                                            <a asp-area="Admin"
                                               asp-controller="Professionals"
                                               asp-action="Edit"
                                               asp-route-id="@professional.Id"
                                               class="action-btn action-edit"
                                               title="Editar profesional"
                                               aria-label="Editar profesional">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            @if (professional.IsActive)
                                            {
                                                <form asp-area="Admin"
                                                      asp-controller="Professionals"
                                                      asp-action="Deactivate"
                                                      asp-route-id="@professional.Id"
                                                      method="post"
                                                      onsubmit="return confirm('¿Desactivar este profesional?');">

                                                    <button type="submit"
                                                            class="action-btn action-deactivate"
                                                            title="Desactivar profesional"
                                                            aria-label="Desactivar profesional">
                                                        <i class="bi bi-person-dash"></i>
                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-area="Admin"
                                                      asp-controller="Professionals"
                                                      asp-action="Activate"
                                                      asp-route-id="@professional.Id"
                                                      method="post"
                                                      onsubmit="return confirm('¿Activar este profesional?');">

                                                    <button type="submit"
                                                            class="action-btn action-activate"
                                                            title="Activar profesional"
                                                            aria-label="Activar profesional">
                                                        <i class="bi bi-person-check"></i>
                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>
