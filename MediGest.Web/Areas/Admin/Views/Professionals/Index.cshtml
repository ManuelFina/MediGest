
@model MediGest.Web.ViewModels.Professionals.ProfessionalListViewModel

@{
    ViewData["Title"] = "Profesionales";
}

<div class="alert alert-success">
    Bootstrap está funcionando en Profesionales.
</div>

<button class="btn btn-primary">
    Botón de prueba
</button>

<div class="container-fluid">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="mb-1">Profesionales</h2>
            <p class="text-muted mb-0">
                Administrá los médicos y sus especialidades.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Professionals"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i>
            Registrar profesional
        </a>
    </div>

    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Total de profesionales</p>
                            <h3 class="mb-0">@Model.TotalProfessionals</h3>
                        </div>
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                            <i class="bi bi-people fs-4 text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Profesionales activos</p>
                            <h3 class="mb-0 text-success">@Model.ActiveProfessionals</h3>
                        </div>
                        <div class="rounded-circle bg-success bg-opacity-10 p-3">
                            <i class="bi bi-person-check fs-4 text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1">Profesionales inactivos</p>
                            <h3 class="mb-0 text-secondary">@Model.InactiveProfessionals</h3>
                        </div>
                        <div class="rounded-circle bg-secondary bg-opacity-10 p-3">
                            <i class="bi bi-person-dash fs-4 text-secondary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 py-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <h5 class="mb-0">Listado de profesionales</h5>

                <form asp-area="Admin"
                      asp-controller="Professionals"
                      asp-action="Index"
                      method="get"
                      class="d-flex gap-2">

                    <input type="search"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           class="form-control"
                           placeholder="Buscar profesional..."
                           style="min-width: 230px;" />

                    <button type="submit" class="btn btn-outline-primary">
                        <i class="bi bi-search"></i>
                    </button>

                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <a asp-area="Admin"
                           asp-controller="Professionals"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </form>
            </div>
        </div>

        <div class="card-body p-0">
            @if (!Model.Professionals.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-vcard display-4 text-muted"></i>
                    <h5 class="mt-3">No hay profesionales registrados</h5>
                    <p class="text-muted mb-3">
                        Todavía no se encontraron profesionales para mostrar.
                    </p>
                    <a asp-area="Admin"
                       asp-controller="Professionals"
                       asp-action="Create"
                       class="btn btn-primary">
                        Registrar primer profesional
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Profesional</th>
                                <th>Especialidad</th>
                                <th>Matrícula</th>
                                <th>Estado</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var professional in Model.Professionals)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-semibold">
                                            @professional.ApplicationUser.LastName,
                                            @professional.ApplicationUser.FirstName
                                        </div>
                                        <small class="text-muted">
                                            @professional.ApplicationUser.Email
                                        </small>
                                    </td>

                                    <td>
                                        @professional.Specialty.Name
                                    </td>

                                    <td>
                                        <span class="text-muted">
                                            @professional.LicenseNumber
                                        </span>
                                    </td>

                                    <td>
                                        @if (professional.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">
                                                Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-2">

                                            <a asp-area="Admin"
                                               asp-controller="Professionals"
                                               asp-action="Edit"
                                               asp-route-id="@professional.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            @if (professional.IsActive)
                                            {
                                                <form asp-area="Admin"
                                                      asp-controller="Professionals"
                                                      asp-action="Deactivate"
                                                      asp-route-id="@professional.Id"
                                                      method="post"
                                                      onsubmit="return confirm('¿Desactivar este profesional?');">

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Desactivar">
                                                        <i class="bi bi-person-dash"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-area="Admin"
                                                      asp-controller="Professionals"
                                                      asp-action="Activate"
                                                      asp-route-id="@professional.Id"
                                                      method="post"
                                                      onsubmit="return confirm('¿Activar este profesional?');">

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success"
                                                            title="Activar">
                                                        <i class="bi bi-person-check"></i>
                                                    </button>
                                                </form>
                                            }

                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>
