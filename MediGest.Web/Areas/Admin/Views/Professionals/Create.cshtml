
@model MediGest.Web.ViewModels.Professionals.ProfessionalFormViewModel

@{
    ViewData["Title"] = "Registrar profesional";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin/users.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin/professionals.css"
          asp-append-version="true" />
}

<div class="container-fluid admin-page">

    <!-- Encabezado -->
    <div class="page-header mb-4">

        <div class="mt-3">
            <h2 class="page-title mb-1">Registrar profesional</h2>
            <p class="page-subtitle mb-0">
                Vinculá un usuario médico con su matrícula y especialidad.
            </p>
        </div>

    </div>

    <div class="row">
        <div class="col-lg-8 col-xl-7">

            <div class="content-card">

                <div class="content-card-header">
                    <h5 class="section-title mb-1">
                        <i class="bi bi-person-vcard me-2"></i>
                        Información profesional
                    </h5>

                    <p class="section-description mb-0">
                        Completá los datos necesarios para registrar al profesional.
                    </p>
                </div>

                <div class="p-4">

                    <form asp-area="Admin"
                          asp-controller="Professionals"
                          asp-action="Create"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger validation-summary"
                             role="alert">
                        </div>

                        <!-- Usuario -->
                        <div class="professional-form-section">

                            <div class="form-section-heading">
                                <div class="form-section-icon">
                                    <i class="bi bi-person"></i>
                                </div>

                                <div>
                                    <h6 class="form-section-title">
                                        Cuenta de usuario
                                    </h6>
                                    <p class="form-section-description">
                                        Seleccioná la cuenta que utilizará el profesional.
                                    </p>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label asp-for="ApplicationUserId"
                                       class="form-label"></label>

                                <select asp-for="ApplicationUserId"
                                        asp-items="Model.AvailableUsers"
                                        class="form-select">
                                    <option value="">Seleccioná un usuario médico</option>
                                </select>

                                <span asp-validation-for="ApplicationUserId"
                                      class="text-danger small"></span>

                                <div class="form-hint">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Solo aparecen usuarios que tienen asignado el rol Doctor.
                                </div>
                            </div>

                        </div>

                        <hr class="form-divider" />

                        <!-- Datos profesionales -->
                        <div class="professional-form-section">

                            <div class="form-section-heading">
                                <div class="form-section-icon access-icon">
                                    <i class="bi bi-clipboard2-pulse"></i>
                                </div>

                                <div>
                                    <h6 class="form-section-title">
                                        Datos profesionales
                                    </h6>
                                    <p class="form-section-description">
                                        Indicá la especialidad y matrícula habilitante.
                                    </p>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label asp-for="SpecialtyId"
                                       class="form-label"></label>

                                <select asp-for="SpecialtyId"
                                        asp-items="Model.AvailableSpecialties"
                                        class="form-select">
                                    <option value="0">Seleccioná una especialidad</option>
                                </select>

                                <span asp-validation-for="SpecialtyId"
                                      class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="LicenseNumber"
                                       class="form-label"></label>

                                <input asp-for="LicenseNumber"
                                       class="form-control"
                                       placeholder="Ej. MP-12345" />

                                <span asp-validation-for="LicenseNumber"
                                      class="text-danger small"></span>
                            </div>

                        </div>

                        <!-- Información -->
                        <div class="form-info mt-4">
                            <i class="bi bi-lightbulb-fill"></i>

                            <div>
                                <strong>Importante</strong>
                                <p class="mb-0">
                                    Primero debe existir una cuenta de usuario con el rol
                                    Doctor. El registro profesional vincula esa cuenta
                                    con sus datos laborales.
                                </p>
                            </div>
                        </div>

                        <!-- Acciones -->
                        <div class="form-actions">

                            <a asp-area="Admin"
                               asp-controller="Professionals"
                               asp-action="Index"
                               class="btn btn-admin-light">
                                Cancelar
                            </a>

                            <button type="submit" class="btn btn-admin-primary">
                                <i class="bi bi-person-plus me-1"></i>
                                Registrar profesional
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
