
@model MediGest.Web.ViewModels.Users.UserFormViewModel

@{
    ViewData["Title"] = "Nuevo usuario";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin/users.css"
          asp-append-version="true" />
}

<div class="container-fluid admin-page">

    <!-- Encabezado -->
    <div class="page-header mb-4">

        <a asp-area="Admin"
           asp-controller="Users"
           asp-action="Index"
           class="back-link">
            <i class="bi bi-arrow-left me-1"></i>
            Volver a usuarios
        </a>

        <div class="mt-3">
            <h2 class="page-title mb-1">Nuevo usuario</h2>
            <p class="page-subtitle mb-0">
                Creá una cuenta de acceso para el sistema MediGest.
            </p>
        </div>

    </div>

    <!-- Formulario -->
    <div class="content-card">

        <div class="content-card-header">
            <h5 class="section-title mb-1">
                <i class="bi bi-person-plus me-2"></i>
                Información de la cuenta
            </h5>

            <p class="section-description mb-0">
                Completá los datos personales y configurá los permisos de acceso.
            </p>
        </div>

        <div class="p-4">

            <form asp-area="Admin"
                  asp-controller="Users"
                  asp-action="Create"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger validation-summary"
                     role="alert">
                </div>

                <!-- Datos personales -->
                <div class="form-section">

                    <div class="form-section-heading">
                        <div class="form-section-icon">
                            <i class="bi bi-person-vcard"></i>
                        </div>

                        <div>
                            <h6 class="form-section-title">Datos personales</h6>
                            <p class="form-section-description">
                                Información básica del usuario.
                            </p>
                        </div>
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName"
                                   class="form-control"
                                   placeholder="Ingresá el nombre" />
                            <span asp-validation-for="FirstName"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName"
                                   class="form-control"
                                   placeholder="Ingresá el apellido" />
                            <span asp-validation-for="LastName"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email"
                                   type="email"
                                   class="form-control"
                                   placeholder="usuario@correo.com" />
                            <span asp-validation-for="Email"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber"
                                   class="form-control"
                                   placeholder="Ingresá el teléfono" />
                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger small"></span>
                        </div>

                    </div>

                </div>

                <hr class="form-divider" />

                <!-- Acceso al sistema -->
                <div class="form-section">

                    <div class="form-section-heading">
                        <div class="form-section-icon access-icon">
                            <i class="bi bi-shield-lock"></i>
                        </div>

                        <div>
                            <h6 class="form-section-title">Acceso al sistema</h6>
                            <p class="form-section-description">
                                Definí el rol y las credenciales de inicio de sesión.
                            </p>
                        </div>
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label"></label>
                            <select asp-for="Role"
                                    asp-items="Model.AvailableRoles"
                                    class="form-select">
                                <option value="">Seleccioná un rol</option>
                            </select>
                            <span asp-validation-for="Role"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Ingresá una contraseña" />
                            <span asp-validation-for="Password"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control"
                                   autocomplete="new-password"
                                   placeholder="Repetí la contraseña" />
                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger small"></span>
                        </div>

                    </div>

                </div>

                <!-- Información -->
                <div class="form-info mt-4">
                    <i class="bi bi-info-circle-fill"></i>

                    <div>
                        <strong>Información importante</strong>
                        <p class="mb-0">
                            La cuenta se creará activa y podrá iniciar sesión
                            con el correo y la contraseña asignados.
                        </p>
                    </div>
                </div>

                <!-- Acciones -->
                <div class="form-actions">

                    <a asp-area="Admin"
                       asp-controller="Users"
                       asp-action="Index"
                       class="btn btn-admin-light">
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-admin-primary">
                        <i class="bi bi-person-plus me-1"></i>
                        Crear usuario
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
