
@model MediGest.Web.ViewModels.Users.UserListViewModel

@{
    ViewData["Title"] = "Usuarios";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin/users.css"
          asp-append-version="true" />
}

<div class="container-fluid admin-page">

    <!-- Encabezado -->
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="page-title mb-1">Gestión de usuarios</h2>
            <p class="page-subtitle mb-0">
                Administrá las cuentas de acceso y los permisos del sistema.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Users"
           asp-action="Create"
           class="btn btn-admin-primary">
            <i class="bi bi-person-plus me-2"></i>
            Nuevo usuario
        </a>
    </div>

    <!-- Mensajes -->
    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4"
             role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4"
             role="alert">
            <i class="bi bi-exclamation-circle-fill me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    <!-- Estadísticas -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Total de usuarios</div>
                        <div class="stat-value">@Model.TotalUsers</div>
                    </div>

                    <div class="stat-icon primary">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Usuarios activos</div>
                        <div class="stat-value">@Model.ActiveUsers</div>
                    </div>

                    <div class="stat-icon success">
                        <i class="bi bi-person-check"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="stat-label">Usuarios inactivos</div>
                        <div class="stat-value">@Model.InactiveUsers</div>
                    </div>

                    <div class="stat-icon danger">
                        <i class="bi bi-person-x"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Listado de usuarios -->
    <div class="content-card">

        <div class="content-card-header">

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                <div>
                    <h5 class="section-title">Listado de usuarios</h5>
                    <p class="section-description">
                        Consultá, buscá y administrá las cuentas registradas.
                    </p>
                </div>

                <span class="text-muted small">
                    <i class="bi bi-shield-check me-1"></i>
                    Administración de accesos
                </span>
            </div>

            <!-- Buscador -->
            <form asp-area="Admin"
                  asp-controller="Users"
                  asp-action="Index"
                  method="get"
                  class="row g-2">

                <div class="col-lg-8">
                    <input type="text"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           class="form-control search-input"
                           placeholder="Buscar por nombre, apellido o correo..." />
                </div>

                <div class="col-lg-4 d-flex gap-2">
                    <button type="submit" class="btn btn-admin-primary">
                        <i class="bi bi-search me-1"></i>
                        Buscar
                    </button>

                    <a asp-area="Admin"
                       asp-controller="Users"
                       asp-action="Index"
                       class="btn btn-admin-light">
                        <i class="bi bi-x-circle me-1"></i>
                        Limpiar
                    </a>
                </div>

            </form>
        </div>

        <!-- Tabla -->
        <div class="table-responsive">

            @if (!Model.Users.Any())
            {
                <div class="empty-state">
                    <div class="empty-state-icon">
                        <i class="bi bi-people"></i>
                    </div>

                    <h5>No hay usuarios registrados</h5>

                    <p class="mb-0">
                        No se encontraron cuentas con los criterios ingresados.
                    </p>
                </div>
            }
            else
            {
                <table class="table table-hover align-middle users-table">

                    <thead>
                        <tr>
                            <th>Usuario</th>
                            <th>Correo electrónico</th>
                            <th>Teléfono</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Fecha de creación</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td>
                                    <span class="user-name">@user.FullName</span>
                                </td>

                                <td>
                                    <span class="user-email">@user.Email</span>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(user.PhoneNumber)
                                        ? "No especificado"
                                        : user.PhoneNumber)
                                </td>

                                <td>
                                    @switch (user.Role)
                                    {
                                        case "Administrator":
                                            <span class="role-badge role-admin">
                                                Administrador
                                            </span>
                                            break;

                                        case "Receptionist":
                                            <span class="role-badge role-reception">
                                                Recepcionista
                                            </span>
                                            break;

                                        case "Doctor":
                                            <span class="role-badge role-doctor">
                                                Profesional
                                            </span>
                                            break;

                                        default:
                                            <span class="role-badge role-default">
                                                Sin rol
                                            </span>
                                            break;
                                    }
                                </td>

                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="bi bi-check-circle-fill me-1"></i>
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            <i class="bi bi-x-circle-fill me-1"></i>
                                            Inactivo
                                        </span>
                                    }
                                </td>

                                <td>
                                    @user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">

                                        <a asp-area="Admin"
                                           asp-controller="Users"
                                           asp-action="Edit"
                                           asp-route-id="@user.Id"
                                           class="action-btn action-edit"
                                           title="Editar usuario"
                                           aria-label="Editar usuario">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        @if (user.IsActive)
                                        {
                                            <form asp-area="Admin"
                                                  asp-controller="Users"
                                                  asp-action="Deactivate"
                                                  asp-route-id="@user.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('¿Deseás desactivar esta cuenta?');">

                                                <button type="submit"
                                                        class="action-btn action-deactivate"
                                                        title="Desactivar usuario"
                                                        aria-label="Desactivar usuario">
                                                    <i class="bi bi-person-x"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-area="Admin"
                                                  asp-controller="Users"
                                                  asp-action="Activate"
                                                  asp-route-id="@user.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('¿Deseás activar esta cuenta?');">

                                                <button type="submit"
                                                        class="action-btn action-activate"
                                                        title="Activar usuario"
                                                        aria-label="Activar usuario">
                                                    <i class="bi bi-person-check"></i>
                                                </button>
                                            </form>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            }

        </div>
    </div>

</div>
