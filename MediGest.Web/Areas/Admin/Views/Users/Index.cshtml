
@model MediGest.Web.ViewModels.Users.UserListViewModel

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Usuarios</h2>
            <p class="text-muted mb-0">
                Administrá las cuentas de acceso al sistema.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Users"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i>
            Nuevo usuario
        </a>
    </div>

    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Total de usuarios</div>
                    <h3 class="fw-bold mb-0">@Model.TotalUsers</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Usuarios activos</div>
                    <h3 class="fw-bold text-success mb-0">@Model.ActiveUsers</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Usuarios inactivos</div>
                    <h3 class="fw-bold text-danger mb-0">@Model.InactiveUsers</h3>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <form asp-area="Admin"
                  asp-controller="Users"
                  asp-action="Index"
                  method="get"
                  class="row g-2">

                <div class="col-md-8">
                    <input type="text"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           class="form-control"
                           placeholder="Buscar por nombre, apellido o correo..." />
                </div>

                <div class="col-md-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search me-1"></i>
                        Buscar
                    </button>

                    <a asp-area="Admin"
                       asp-controller="Users"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Limpiar
                    </a>
                </div>

            </form>
        </div>

        <div class="card-body p-0">

            @if (!Model.Users.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-people fs-1 text-muted"></i>
                    <h5 class="mt-3">No hay usuarios registrados</h5>
                    <p class="text-muted mb-0">
                        No se encontraron cuentas con los criterios ingresados.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th>Usuario</th>
                                <th>Correo electrónico</th>
                                <th>Teléfono</th>
                                <th>Rol</th>
                                <th>Estado</th>
                                <th>Fecha de creación</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @user.FullName
                                    </td>

                                    <td>@user.Email</td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(user.PhoneNumber)
                                            ? "No especificado"
                                            : user.PhoneNumber)
                                    </td>

                                    <td>
                                        @switch (user.Role)
                                        {
                                            case "Administrator":
                                                <span class="badge bg-dark">Administrador</span>
                                                break;

                                            case "Receptionist":
                                                <span class="badge bg-info text-dark">Recepcionista</span>
                                                break;

                                            case "Doctor":
                                                <span class="badge bg-primary">Profesional</span>
                                                break;

                                            default:
                                                <span class="badge bg-secondary">Sin rol</span>
                                                break;
                                        }
                                    </td>

                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactivo</span>
                                        }
                                    </td>

                                    <td>
                                        @user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                    </td>

                                    <td class="text-end">
                                        <a asp-area="Admin"
                                           asp-controller="Users"
                                           asp-action="Edit"
                                           asp-route-id="@user.Id"
                                           class="btn btn-sm btn-outline-primary"
                                           title="Editar usuario">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        @if (user.IsActive)
                                        {
                                            <form asp-area="Admin"
                                                  asp-controller="Users"
                                                  asp-action="Deactivate"
                                                  asp-route-id="@user.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('¿Deseás desactivar esta cuenta?');">

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Desactivar usuario">
                                                    <i class="bi bi-person-x"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-area="Admin"
                                                  asp-controller="Users"
                                                  asp-action="Activate"
                                                  asp-route-id="@user.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('¿Deseás activar esta cuenta?');">

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success"
                                                        title="Activar usuario">
                                                    <i class="bi bi-person-check"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>
</div>
