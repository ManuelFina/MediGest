
@model MediGest.Web.ViewModels.HealthInsurances.HealthInsuranceFormViewModel

@{
    ViewData["Title"] = "Nueva cobertura médica";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold mb-1">Nueva cobertura médica</h2>
        <p class="text-muted mb-0">
            Registrá una obra social, prepaga u otra entidad.
        </p>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <partial name="_Form" model="Model" />

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary">
                        Guardar cobertura
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
