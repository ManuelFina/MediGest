
@model MediGest.Web.ViewModels.HealthInsurances.HealthInsuranceListViewModel
@using MediGest.Web.Models.Enums

@{
    ViewData["Title"] = "Obras sociales y prepagas";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Obras sociales y prepagas</h2>
            <p class="text-muted mb-0">
                Administración de entidades de cobertura médica.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="HealthInsurances"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Nueva cobertura
        </a>
    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Total de coberturas</div>
                    <h3 class="fw-bold mb-0">@Model.TotalHealthInsurances</h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Activas</div>
                    <h3 class="fw-bold text-success mb-0">
                        @Model.ActiveHealthInsurances
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Inactivas</div>
                    <h3 class="fw-bold text-secondary mb-0">
                        @Model.InactiveHealthInsurances
                    </h3>
                </div>
            </div>
        </div>

    </div>

    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">Coberturas registradas</h5>
        </div>

        <div class="card-body p-0">
            @if (!Model.HealthInsurances.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-shield-plus fs-1 text-muted"></i>
                    <h5 class="mt-3">Todavía no hay coberturas registradas</h5>
                    <p class="text-muted mb-3">
                        Registrá una obra social o prepaga para comenzar.
                    </p>
                    <a asp-action="Create" class="btn btn-primary">
                        Nueva cobertura
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre</th>
                                <th>Razón social</th>
                                <th>CUIT</th>
                                <th>Tipo</th>
                                <th class="text-center">Planes</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var insurance in Model.HealthInsurances)
                            {
                                <tr>
                                    <td class="fw-semibold">@insurance.Name</td>
                                    <td>@insurance.LegalName</td>
                                    <td>@insurance.CUIT</td>
                                    <td>
                                        @switch (insurance.EntityType)
                                        {
                                            case HealthInsuranceType.SocialSecurity:
                                                <span>Obra social</span>
                                                break;
                                            case HealthInsuranceType.PrepaidMedicine:
                                                <span>Prepaga</span>
                                                break;
                                            default:
                                                <span>Otra</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark">
                                            @(insurance.Plans?.Count ?? 0)
                                        </span>
                                    </td>
                                    <td>
                                        @if (insurance.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success">
                                                Activa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">
                                                Inactiva
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-action="Edit"
                                               asp-route-id="@insurance.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            @if (insurance.IsActive)
                                            {
                                                <form asp-action="Deactivate"
                                                      asp-route-id="@insurance.Id"
                                                      method="post"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Desactivar">
                                                        <i class="bi bi-toggle-off"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-action="Activate"
                                                      asp-route-id="@insurance.Id"
                                                      method="post"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success"
                                                            title="Activar">
                                                        <i class="bi bi-toggle-on"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
