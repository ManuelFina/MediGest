
@model MediGest.Web.ViewModels.Specialties.SpecialtyFormViewModel

@{
    ViewData["Title"] = "Nueva especialidad";
}

<div class="container-fluid">

    <div class="mb-4">
        <a asp-area="Admin"
           asp-controller="Specialties"
           asp-action="Index"
           class="text-decoration-none text-muted">
            <i class="bi bi-arrow-left me-1"></i>
            Volver a especialidades
        </a>

        <h2 class="fw-bold mt-3 mb-1">Nueva especialidad</h2>
        <p class="text-muted mb-0">
            Registrá una nueva especialidad médica en el sistema.
        </p>
    </div>

    <div class="row">
        <div class="col-lg-7 col-xl-6">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 py-3">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-clipboard2-pulse text-primary me-2"></i>
                        Datos de la especialidad
                    </h5>
                </div>

                <div class="card-body">

                    <form asp-area="Admin"
                          asp-controller="Specialties"
                          asp-action="Create"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold"></label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Ej. Cardiología" />

                            <span asp-validation-for="Name"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold"></label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Descripción opcional de la especialidad..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-area="Admin"
                               asp-controller="Specialties"
                               asp-action="Index"
                               class="btn btn-light border">
                                Cancelar
                            </a>

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>
                                Guardar especialidad
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
