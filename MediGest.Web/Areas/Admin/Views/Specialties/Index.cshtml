
@model MediGest.Web.ViewModels.Specialties.SpecialtyListViewModel

@{
    ViewData["Title"] = "Especialidades";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin/users.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin/specialties.css"
          asp-append-version="true" />
}

<div class="container-fluid admin-page">

    <!-- Encabezado -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h2 class="page-title mb-1">Especialidades médicas</h2>
            <p class="page-subtitle mb-0">
                Administrá las especialidades disponibles en MediGest.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Specialties"
           asp-action="Create"
           class="btn btn-admin-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Nueva especialidad
        </a>

    </div>

    <!-- Mensajes -->
    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    <!-- Estadísticas -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="stat-card h-100">
                <div>
                    <p class="stat-label">Total de especialidades</p>
                    <h3 class="stat-value">@Model.TotalSpecialties</h3>
                </div>

                <div class="stat-icon stat-icon-primary">
                    <i class="bi bi-clipboard2-pulse"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card h-100">
                <div>
                    <p class="stat-label">Especialidades activas</p>
                    <h3 class="stat-value text-success">
                        @Model.ActiveSpecialties
                    </h3>
                </div>

                <div class="stat-icon stat-icon-success">
                    <i class="bi bi-check-circle"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card h-100">
                <div>
                    <p class="stat-label">Especialidades inactivas</p>
                    <h3 class="stat-value text-secondary">
                        @Model.InactiveSpecialties
                    </h3>
                </div>

                <div class="stat-icon stat-icon-secondary">
                    <i class="bi bi-pause-circle"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- Listado -->
    <div class="content-card">

        <div class="content-card-header">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div>
                    <h5 class="section-title mb-1">
                        Listado de especialidades
                    </h5>

                    <p class="section-description mb-0">
                        Consultá las especialidades y los profesionales asociados.
                    </p>
                </div>

                <form asp-area="Admin"
                      asp-controller="Specialties"
                      asp-action="Index"
                      method="get"
                      class="specialty-search">

                    <input type="search"
                           name="searchTerm"
                           value="@Model.SearchTerm"
                           class="form-control"
                           placeholder="Buscar especialidad..."
                           aria-label="Buscar especialidad" />

                    <button type="submit"
                            class="btn btn-admin-primary"
                            title="Buscar">
                        <i class="bi bi-search"></i>
                    </button>

                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <a asp-area="Admin"
                           asp-controller="Specialties"
                           asp-action="Index"
                           class="btn btn-admin-light"
                           title="Limpiar búsqueda">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }

                </form>

            </div>

        </div>

        <div class="content-card-body p-0">

            @if (!Model.Specialties.Any())
            {
                <div class="empty-state">

                    <div class="empty-state-icon">
                        <i class="bi bi-clipboard2-x"></i>
                    </div>

                    <h5>No se encontraron especialidades</h5>

                    <p>
                        Todavía no hay especialidades para mostrar con esta búsqueda.
                    </p>

                    @if (string.IsNullOrWhiteSpace(Model.SearchTerm))
                    {
                        <a asp-area="Admin"
                           asp-controller="Specialties"
                           asp-action="Create"
                           class="btn btn-admin-primary">
                            <i class="bi bi-plus-lg me-1"></i>
                            Registrar primera especialidad
                        </a>
                    }

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table users-table specialties-table mb-0">

                        <thead>
                            <tr>
                                <th class="ps-4">Especialidad</th>
                                <th>Descripción</th>
                                <th class="text-center">Médicos</th>
                                <th class="text-center">Estado</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var specialty in Model.Specialties)
                            {
                                <tr>

                                    <td class="ps-4">
                                        <div class="specialty-title">
                                            <div class="specialty-icon">
                                                <i class="bi bi-clipboard2-pulse"></i>
                                            </div>

                                            <span>@specialty.Name</span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="specialty-description">
                                            @(string.IsNullOrWhiteSpace(specialty.Description)
                                                ? "Sin descripción"
                                                : specialty.Description)
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        <span class="professional-count">
                                            <i class="bi bi-people me-1"></i>
                                            @specialty.ProfessionalsCount
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        @if (specialty.IsActive)
                                        {
                                            <span class="status-badge status-active">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Activa
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-inactive">
                                                <i class="bi bi-pause-circle me-1"></i>
                                                Inactiva
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end pe-4">

                                        <div class="d-inline-flex gap-2">

                                            <a asp-area="Admin"
                                               asp-controller="Specialties"
                                               asp-action="Edit"
                                               asp-route-id="@specialty.Id"
                                               class="action-btn action-edit"
                                               title="Editar especialidad"
                                               aria-label="Editar especialidad">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            @if (specialty.IsActive)
                                            {
                                                <form asp-area="Admin"
                                                      asp-controller="Specialties"
                                                      asp-action="Deactivate"
                                                      asp-route-id="@specialty.Id"
                                                      method="post"
                                                      onsubmit="return confirm('¿Estás seguro de desactivar esta especialidad?');">

                                                    <button type="submit"
                                                            class="action-btn action-deactivate"
                                                            title="Desactivar especialidad"
                                                            aria-label="Desactivar especialidad">
                                                        <i class="bi bi-pause-circle"></i>
                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-area="Admin"
                                                      asp-controller="Specialties"
                                                      asp-action="Activate"
                                                      asp-route-id="@specialty.Id"
                                                      method="post"
                                                      onsubmit="return confirm('¿Deseás volver a activar esta especialidad?');">

                                                    <button type="submit"
                                                            class="action-btn action-activate"
                                                            title="Activar especialidad"
                                                            aria-label="Activar especialidad">
                                                        <i class="bi bi-check-circle"></i>
                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

        <div class="content-card-footer">
            <small>
                Mostrando @Model.Specialties.Count() especialidades.
            </small>
        </div>

    </div>

</div>
