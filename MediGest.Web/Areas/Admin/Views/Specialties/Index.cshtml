
@model MediGest.Web.ViewModels.Specialties.SpecialtyListViewModel

@{
    ViewData["Title"] = "Especialidades";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin/users.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin/specialties.css"
          asp-append-version="true" />
}

<div class="container-fluid admin-page">

    <!-- Encabezado -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <h2 class="page-title mb-1">Especialidades médicas</h2>

            <p class="page-subtitle mb-0">
                Administrá las especialidades disponibles en MediGest.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Specialties"
           asp-action="Create"
           class="btn btn-admin-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Nueva especialidad
        </a>

    </div>

    <!-- Mensajes -->
    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar"></button>
        </div>
    }

    <!-- Estadísticas -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="stat-card h-100">

                <div>
                    <p class="stat-label">Total de especialidades</p>
                    <h3 class="stat-value">@Model.TotalSpecialties</h3>
                </div>

                <div class="stat-icon stat-icon-primary">
                    <i class="bi bi-clipboard2-pulse"></i>
                </div>

            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card h-100">

                <div>
                    <p class="stat-label">Especialidades activas</p>

                    <h3 class="stat-value text-success">
                        @Model.ActiveSpecialties
                    </h3>
                </div>

                <div class="stat-icon stat-icon-success">
                    <i class="bi bi-check-circle"></i>
                </div>

            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-card h-100">

                <div>
                    <p class="stat-label">Especialidades inactivas</p>

                    <h3 class="stat-value text-secondary">
                        @Model.InactiveSpecialties
                    </h3>
                </div>

                <div class="stat-icon stat-icon-secondary">
                    <i class="bi bi-pause-circle"></i>
                </div>

            </div>
        </div>

    </div>

    <!-- Listado -->
    <div class="content-card">

        <div class="content-card-header">

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div>
                    <h5 class="section-title mb-1">
                        Listado de especialidades
                    </h5>

                    <p class="section-description mb-0">
                        Consultá las especialidades y los profesionales asociados.
                    </p>
                </div>

                <!-- Buscador -->
                <div class="specialty-search">

                    <input type="search"
                           id="specialtySearch"
                           value="@Model.SearchTerm"
                           class="form-control"
                           placeholder="Buscar especialidad..."
                           aria-label="Buscar especialidad"
                           autocomplete="off" />

                    <button type="button"
                            id="clearSpecialtySearch"
                            class="btn btn-admin-light"
                            title="Limpiar búsqueda"
                            aria-label="Limpiar búsqueda">
                        <i class="bi bi-x-lg"></i>
                    </button>

                </div>

            </div>

        </div>

        <!-- Tabla -->
        <div class="content-card-body p-0">

            <div class="table-responsive">

                <table class="table users-table specialties-table mb-0">

                    <thead>
                        <tr>
                            <th class="ps-4">Especialidad</th>
                            <th>Descripción</th>
                            <th class="text-center">Médicos</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>

                    <tbody id="specialtiesTableBody">

                        @await Html.PartialAsync(
                            "_SpecialtyRows",
                            Model.Specialties)

                    </tbody>

                </table>

            </div>

        </div>

        <!-- Contador -->
        <div class="content-card-footer">

            <small id="specialtyResultsCount">
                Mostrando @Model.Specialties.Count() especialidades.
            </small>

        </div>

    </div>

</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const searchInput = document.getElementById("specialtySearch");
            const clearButton = document.getElementById("clearSpecialtySearch");
            const tableBody = document.getElementById("specialtiesTableBody");
            const resultsCount = document.getElementById("specialtyResultsCount");

            const searchUrl = '@Url.Action("Search", "Specialties", new { area = "Admin" })';

            let debounceTimer;
            let currentRequest = null;

            async function searchSpecialties() {

                const searchTerm = searchInput.value.trim();

                if (currentRequest) {
                    currentRequest.abort();
                }

                currentRequest = new AbortController();

                try {

                    const url = new URL(searchUrl, window.location.origin);

                    url.searchParams.set("searchTerm", searchTerm);

                    const response = await fetch(url, {
                        method: "GET",
                        headers: {
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        signal: currentRequest.signal
                    });

                    if (!response.ok) {
                        throw new Error("No se pudo realizar la búsqueda.");
                    }

                    const html = await response.text();

                    tableBody.innerHTML = html;

                    const count = Number(
                        response.headers.get("X-Results-Count") ?? 0
                    );

                    resultsCount.textContent =
                        `Mostrando ${count} especialidad${count === 1 ? "" : "es"}.`;

                    // Actualizar URL sin recargar la página.
                    const browserUrl = new URL(window.location.href);

                    if (searchTerm) {
                        browserUrl.searchParams.set("searchTerm", searchTerm);
                    } else {
                        browserUrl.searchParams.delete("searchTerm");
                    }

                    window.history.replaceState({}, "", browserUrl);

                } catch (error) {

                    if (error.name !== "AbortError") {
                        console.error(error);

                        resultsCount.textContent =
                            "Ocurrió un error al buscar especialidades.";
                    }
                }
            }

            // Búsqueda automática con debounce.
            searchInput.addEventListener("input", function () {

                clearTimeout(debounceTimer);

                debounceTimer = setTimeout(
                    searchSpecialties,
                    300
                );

            });

            // Limpiar búsqueda.
            clearButton.addEventListener("click", function () {

                searchInput.value = "";

                clearTimeout(debounceTimer);

                searchSpecialties();

                searchInput.focus();

            });

        });
    </script>

}
