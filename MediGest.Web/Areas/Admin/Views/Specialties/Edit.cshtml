
@model MediGest.Web.ViewModels.Specialties.SpecialtyFormViewModel

@{
    ViewData["Title"] = "Editar especialidad";
}

<div class="container-fluid admin-page">

    <div class="page-header">
        <div>
            <h2 class="page-title mt-3">Editar especialidad</h2>

            <p class="page-subtitle">
                Modificá los datos de la especialidad seleccionada.
            </p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 col-xl-7">

            <div class="content-card">

                <div class="content-card-header">
                    <div>
                        <h5 class="section-title">
                            <i class="bi bi-pencil-square me-2"></i>
                            Datos de la especialidad
                        </h5>

                        <p class="section-description">
                            Actualizá la información de esta especialidad médica.
                        </p>
                    </div>
                </div>

                <div class="p-4">

                    <form asp-area="Admin"
                          asp-controller="Specialties"
                          asp-action="Edit"
                          asp-route-id="@Model.Id"
                          method="post">

                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly"
                             class="validation-summary text-danger mb-3">
                        </div>

                        <div class="form-section">

                            <div class="form-section-heading">
                                <div class="form-section-icon">
                                    <i class="bi bi-card-text"></i>
                                </div>

                                <div>
                                    <h6 class="form-section-title">
                                        Información general
                                    </h6>

                                    <p class="form-section-description">
                                        Modificá los datos principales de la especialidad.
                                    </p>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Name" class="form-label"></label>

                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="Ej. Cardiología" />

                                <span asp-validation-for="Name"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label"></label>

                                <textarea asp-for="Description"
                                          class="form-control"
                                          rows="4"
                                          placeholder="Descripción opcional de la especialidad..."></textarea>

                                <span asp-validation-for="Description"
                                      class="text-danger small">
                                </span>

                                <div class="form-info mt-2">
                                    <i class="bi bi-info-circle me-1"></i>
                                    La descripción es opcional y permite identificar
                                    el área de atención de la especialidad.
                                </div>
                            </div>

                        </div>

                        <div class="form-divider"></div>

                        <div class="form-actions">

                            <a asp-area="Admin"
                               asp-controller="Specialties"
                               asp-action="Index"
                               class="btn btn-admin-light">
                                Cancelar
                            </a>

                            <button type="submit" class="btn btn-admin-primary">
                                <i class="bi bi-check-lg me-1"></i>
                                Guardar cambios
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin/users.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin/specialties.css"
          asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
