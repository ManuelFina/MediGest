
@model MediGest.Web.ViewModels.HealthPlanTariffs.HealthPlanTariffListViewModel

@{
    ViewData["Title"] = "Tarifas por plan";

    var pagination = ViewBag.Pagination as
        MediGest.Web.ViewModels.HealthPlanTariffs.HealthPlanTariffSearchViewModel;

    int currentPage = pagination?.Page ?? 1;
    int totalPages = pagination?.TotalPages ?? 1;
    int totalCount = pagination?.TotalCount ?? Model.TotalTariffs;
    int pageSize = pagination?.PageSize ?? 25;
    int displayedCount = Model.Tariffs.Count();
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/admin/users.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/admin/specialties.css"
          asp-append-version="true" />
}

<div class="container-fluid admin-page">

    <!-- ENCABEZADO -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="page-title">Tarifas por plan</h2>
            <p class="page-subtitle">
                Administrá los importes reconocidos por cada plan de cobertura.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="HealthPlanTariffs"
           asp-action="Create"
           class="btn btn-admin-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Nueva tarifa
        </a>
    </div>

    <!-- MENSAJES -->
    @if (TempData["Success"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ESTADÍSTICAS -->
    <div class="row g-3 mb-4">

        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Total de tarifas</div>
                    <div class="stat-value">@Model.TotalTariffs</div>
                </div>
                <div class="stat-icon stat-icon-primary">
                    <i class="bi bi-list-ul"></i>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Vigentes</div>
                    <div class="stat-value">@Model.CurrentTariffs</div>
                </div>
                <div class="stat-icon stat-icon-success">
                    <i class="bi bi-check-circle"></i>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Vencidas</div>
                    <div class="stat-value">@Model.ExpiredTariffs</div>
                </div>
                <div class="stat-icon stat-icon-secondary">
                    <i class="bi bi-calendar-x"></i>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="stat-card">
                <div>
                    <div class="stat-label">Futuras</div>
                    <div class="stat-value">@Model.FutureTariffs</div>
                </div>
                <div class="stat-icon stat-icon-primary">
                    <i class="bi bi-calendar-event"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- LISTADO -->
    <div class="content-card">

        <div class="content-card-header">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

                <div>
                    <h5 class="section-title mb-1">
                        Tarifas registradas
                    </h5>
                    <p class="section-description mb-0">
                        Importes reconocidos por cobertura y prestación.
                    </p>
                </div>

                <div class="specialty-search">
                    <input type="search"
                           id="tariffSearch"
                           class="form-control"
                           placeholder="Buscar tarifa..."
                           autocomplete="off" />

                    <button type="button"
                            id="clearTariffSearch"
                            class="btn btn-admin-light"
                            title="Limpiar búsqueda">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

            </div>
        </div>

        <div class="content-card-body p-0">
            <div class="table-responsive">
                <table class="table users-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Cobertura / Plan</th>
                            <th>Prestación</th>
                            <th>Importe reconocido</th>
                            <th>Vigencia</th>
                            <th>Autorización</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>

                    <tbody id="tariffsTableBody">
                        @await Html.PartialAsync(
                            "_HealthPlanTariffRows",
                            Model.Tariffs)
                    </tbody>
                </table>
            </div>
        </div>

        <!-- PIE Y PAGINACIÓN -->
        <div class="content-card-footer d-flex flex-wrap justify-content-between align-items-center gap-3">

            <small id="tariffResultsCount">
                Mostrando @displayedCount de @totalCount tarifas.
            </small>

            <nav id="tariffPagination"
                 aria-label="Paginación de tarifas"
                 class="d-flex align-items-center gap-2">

                <button type="button"
                        class="btn btn-admin-light btn-sm"
                        id="previousTariffPage"
                        data-page="@(currentPage - 1)"
                        disabled="@(currentPage <= 1)">
                    <i class="bi bi-chevron-left"></i>
                    Anterior
                </button>

                <span id="tariffPageInfo" class="small text-muted">
                    Página @currentPage de @Math.Max(1, totalPages)
                </span>

                <button type="button"
                        class="btn btn-admin-light btn-sm"
                        id="nextTariffPage"
                        data-page="@(currentPage + 1)"
                        disabled="@(currentPage >= totalPages)">
                    Siguiente
                    <i class="bi bi-chevron-right"></i>
                </button>

            </nav>

        </div>

    </div>

</div>

<!-- MODAL PARA CERRAR VIGENCIA -->
<div class="modal fade" id="closeTariffModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form asp-area="Admin"
                  asp-controller="HealthPlanTariffs"
                  asp-action="Close"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        Cerrar vigencia de tarifa
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar"></button>
                </div>

                <div class="modal-body">
                    <p>
                        Vas a cerrar la vigencia de la prestación:
                        <strong id="tariffName"></strong>.
                    </p>

                    <label for="validTo" class="form-label">
                        Fecha de finalización
                    </label>

                    <input type="date"
                           id="validTo"
                           name="validTo"
                           class="form-control"
                           required />

                    <input type="hidden" id="tariffId" name="id" />

                    <div class="form-text">
                        La fecha no puede ser anterior al inicio de vigencia.
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-check-circle me-1"></i>
                        Confirmar cierre
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // ELEMENTOS
            const searchInput = document.getElementById("tariffSearch");
            const clearButton = document.getElementById("clearTariffSearch");
            const tableBody = document.getElementById("tariffsTableBody");
            const resultsCount = document.getElementById("tariffResultsCount");

            const previousButton = document.getElementById("previousTariffPage");
            const nextButton = document.getElementById("nextTariffPage");
            const pageInfo = document.getElementById("tariffPageInfo");

            const searchUrl = '@Url.Action("Search", "HealthPlanTariffs", new { area = "Admin" })';

            let debounceTimer;
            let abortController;
            let currentPage = @currentPage;

            // ACTUALIZAR PAGINACIÓN
            function updatePagination(page, totalPages) {

                currentPage = page;

                const safeTotalPages = Math.max(1, totalPages);

                pageInfo.textContent =
                    `Página ${page} de ${safeTotalPages}`;

                previousButton.disabled = page <= 1;
                nextButton.disabled = page >= safeTotalPages;

                previousButton.dataset.page = Math.max(1, page - 1);
                nextButton.dataset.page = Math.min(safeTotalPages, page + 1);
            }

            // BÚSQUEDA Y PAGINACIÓN AJAX
            async function searchTariffs(page = 1) {

                const searchTerm = searchInput.value.trim();

                if (abortController) {
                    abortController.abort();
                }

                abortController = new AbortController();

                const url = new URL(searchUrl, window.location.origin);

                url.searchParams.set("searchTerm", searchTerm);
                url.searchParams.set("page", page);

                try {
                    const response = await fetch(url, {
                        method: "GET",
                        headers: {
                            "X-Requested-With": "XMLHttpRequest"
                        },
                        signal: abortController.signal
                    });

                    if (!response.ok) {
                        throw new Error("No se pudo realizar la búsqueda.");
                    }

                    const html = await response.text();

                    tableBody.innerHTML = html;

                    const count = Number(
                        response.headers.get("X-Results-Count") ?? 0
                    );

                    const responsePage = Number(
                        response.headers.get("X-Current-Page") ?? 1
                    );

                    const totalPages = Number(
                        response.headers.get("X-Total-Pages") ?? 0
                    );

                    const start = count === 0
                        ? 0
                        : ((responsePage - 1) * @pageSize) + 1;

                    const end = Math.min(
                        responsePage * @pageSize,
                        count
                    );

                    resultsCount.textContent =
                        count === 0
                            ? "No se encontraron tarifas."
                            : `Mostrando ${start} a ${end} de ${count} tarifas.`;

                    updatePagination(responsePage, totalPages);

                    const currentUrl = new URL(window.location.href);

                    if (searchTerm) {
                        currentUrl.searchParams.set("searchTerm", searchTerm);
                    } else {
                        currentUrl.searchParams.delete("searchTerm");
                    }

                    if (responsePage > 1) {
                        currentUrl.searchParams.set("page", responsePage);
                    } else {
                        currentUrl.searchParams.delete("page");
                    }

                    window.history.replaceState({}, "", currentUrl);

                } catch (error) {
                    if (error.name !== "AbortError") {
                        console.error(error);
                    }
                }
            }

            // BUSCADOR CON DEBOUNCE
            searchInput.addEventListener("input", function () {
                clearTimeout(debounceTimer);

                debounceTimer = setTimeout(function () {
                    searchTariffs(1);
                }, 300);
            });

            // LIMPIAR BÚSQUEDA
            clearButton.addEventListener("click", function () {
                searchInput.value = "";
                searchInput.focus();

                clearTimeout(debounceTimer);
                searchTariffs(1);
            });

            // PAGINACIÓN
            previousButton.addEventListener("click", function () {
                if (!previousButton.disabled) {
                    searchTariffs(Number(previousButton.dataset.page));
                }
            });

            nextButton.addEventListener("click", function () {
                if (!nextButton.disabled) {
                    searchTariffs(Number(nextButton.dataset.page));
                }
            });

            // MODAL DE CIERRE
            const closeTariffModal =
                document.getElementById("closeTariffModal");

            closeTariffModal.addEventListener("show.bs.modal", function (event) {

                const button = event.relatedTarget;

                const id = button.getAttribute("data-tariff-id");
                const name = button.getAttribute("data-tariff-name");
                const startDate = button.getAttribute("data-tariff-date");

                document.getElementById("tariffId").value = id;
                document.getElementById("tariffName").textContent = name;

                const validToInput = document.getElementById("validTo");

                validToInput.min = startDate;

                const today = new Date();
                const localToday = new Date(
                    today.getTime() - today.getTimezoneOffset() * 60000
                ).toISOString().split("T")[0];

                validToInput.value =
                    localToday < startDate ? startDate : localToday;
            });

        });
    </script>
}
