
@model MediGest.Web.ViewModels.HealthPlanTariffs.HealthPlanTariffFormViewModel

@{
    ViewData["Title"] = "Nueva tarifa";
}

<div class="container-fluid py-4">

    <!-- Encabezado -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-currency-dollar text-primary me-2"></i>
                Nueva tarifa
            </h2>
            <p class="text-muted mb-0">
                Registrá el importe reconocido por un plan para una prestación médica.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="HealthPlanTariffs"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Volver al listado
        </a>
    </div>

    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">

            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-bold mb-0">
                        Datos de la tarifa
                    </h5>
                </div>

                <div class="card-body p-4">

                    <form asp-area="Admin"
                          asp-controller="HealthPlanTariffs"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert"></div>

                        <div class="row g-3">

                            <!-- Plan de cobertura -->
                            <div class="col-md-12">
                                <label asp-for="HealthPlanId" class="form-label fw-semibold"></label>

                                <select asp-for="HealthPlanId"
                                        asp-items="Model.HealthPlans"
                                        class="form-select">
                                    <option value="">Seleccioná un plan de cobertura</option>
                                </select>

                                <span asp-validation-for="HealthPlanId"
                                      class="text-danger small"></span>
                            </div>

                            <!-- Prestación -->
                            <div class="col-md-12">
                                <label asp-for="MedicalServiceId" class="form-label fw-semibold"></label>

                                <select asp-for="MedicalServiceId"
                                        asp-items="Model.MedicalServices"
                                        class="form-select">
                                    <option value="">Seleccioná una prestación médica</option>
                                </select>

                                <span asp-validation-for="MedicalServiceId"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Amount" class="form-label fw-semibold"></label>

                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="Amount"
                                           type="number"
                                           min="0.01"
                                           step="0.01"
                                           class="form-control"
                                           placeholder="Ej. 15000.00" />
                                </div>

                                <span asp-validation-for="Amount"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ValidFrom" class="form-label fw-semibold"></label>

                                <input asp-for="ValidFrom"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="ValidFrom"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ValidTo" class="form-label fw-semibold"></label>

                                <input asp-for="ValidTo"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="ValidTo"
                                      class="text-danger small"></span>

                                <small class="text-muted">
                                    Dejá vacío si no tiene fecha de finalización definida.
                                </small>
                            </div>

                            <div class="col-md-6 d-flex align-items-center">
                                <div class="form-check mt-4">
                                    <input asp-for="RequiresAuthorization"
                                           class="form-check-input" />

                                    <label asp-for="RequiresAuthorization"
                                           class="form-check-label fw-semibold"></label>
                                </div>
                            </div>

                            <div class="col-12">
                                <label asp-for="Notes" class="form-label fw-semibold"></label>

                                <textarea asp-for="Notes"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Observaciones adicionales (opcional)"></textarea>

                                <span asp-validation-for="Notes"
                                      class="text-danger small"></span>
                            </div>

                        </div>

                        <hr class="my-4" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-area="Admin"
                               asp-controller="HealthPlanTariffs"
                               asp-action="Index"
                               class="btn btn-light">
                                Cancelar
                            </a>

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-1"></i>
                                Registrar tarifa
                            </button>
                        </div>

                    </form>

                </div>
            </div>

            <div class="alert alert-info mt-3 mb-0">
                <i class="bi bi-info-circle-fill me-2"></i>
                Las tarifas que ya comenzaron su vigencia no podrán modificarse.
                Para actualizar un importe, cerrá la tarifa anterior y registrá una nueva.
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
