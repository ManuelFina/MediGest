@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>

<div class="d-flex justify-content-end mb-4">
    <form asp-controller="Account"
          asp-action="Logout"
          method="post">

        <button type="submit" class="btn btn-outline-danger">
            <i class="bi bi-box-arrow-right me-2"></i>
            Cerrar sesión
        </button>
        
@if (User.IsInRole("Administrator") || User.IsInRole("Receptionist"))
{
    <div class="col-md-4 col-lg-3">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-body">
                <div class="mb-3">
                    <i class="bi bi-calendar-check text-primary"
                       style="font-size: 2rem;"></i>
                </div>

                <h5 class="card-title">Gestión de turnos</h5>

                <p class="card-text text-muted">
                    Asigná, confirmá, cancelá y reprogramá
                    los turnos de los pacientes.
                </p>

                <a asp-area="Reception"
                   asp-controller="Appointments"
                   asp-action="Index"
                   class="btn btn-primary">
                    Acceder
                    <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
}


    </form>
</div>