
@model MediGest.Web.ViewModels.Dashboard.AdminDashboardViewModel

@{
    ViewData["Title"] = "Inicio";

    var isAdmin = User.IsInRole("Administrator");
    var isReceptionist = User.IsInRole("Receptionist");
    var isDoctor = User.IsInRole("Doctor");

    var userName = ViewBag.UserName as string
        ?? User.Identity?.Name
        ?? "Usuario";

    if (string.IsNullOrWhiteSpace(userName))
    {
        userName = "Usuario";
    }

    var recentUsers = Model?.RecentUsers
        ?? Enumerable.Empty<MediGest.Web.ViewModels.Dashboard.RecentUserViewModel>();

    var culture = new System.Globalization.CultureInfo("es-AR");
    var today = DateTime.Today;

    var dayNumber = today.ToString("dd");
    var monthName = today.ToString("MMMM", culture);
    var year = today.ToString("yyyy");
    var dayName = culture.TextInfo.ToTitleCase(
        today.ToString("dddd", culture));
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/dashboard.css"
          asp-append-version="true" />
}

<div class="container-fluid px-0">

    <!-- ENCABEZADO -->
    <section class="dashboard-heading">

        <div class="dashboard-welcome">

            <div class="dashboard-welcome-content">

                <span class="dashboard-eyebrow">
                    PANEL DE ADMINISTRACIÓN
                </span>

                <h1 class="dashboard-title">
                    ¡Bienvenido!
                </h1>

                <h2 class="dashboard-user-name">
                    @userName
                </h2>

                <p class="dashboard-description">
                    Este es tu espacio de trabajo en MediGest.
                </p>

            </div>

            <!-- FECHA Y CALENDARIO -->
            <div class="dashboard-calendar-card">

                <div class="dashboard-calendar-header">
                    <span>FECHA ACTUAL</span>

                    <div class="dashboard-calendar-icon">
                        <i class="bi bi-calendar3"></i>
                    </div>
                </div>

                <div class="dashboard-calendar-date">

                    <span class="dashboard-calendar-day">
                        @dayNumber
                    </span>

                    <div class="dashboard-calendar-month">
                        <strong>@monthName.ToUpperInvariant()</strong>
                        <span>@year</span>
                    </div>

                </div>

                <div class="dashboard-calendar-footer">
                    <i class="bi bi-calendar-check"></i>

                    <div>
                        <strong>@dayName</strong>
                        <small>Organizá tu jornada</small>
                    </div>
                </div>

            </div>

        </div>

    </section>

    @if (isAdmin && Model != null)
    {
        <!-- RESUMEN GENERAL -->
        <section class="dashboard-section mb-5">

            <div class="dashboard-section-heading">
                <div>
                    <h3>Resumen general</h3>
                    <p>
                        Estado actual de la administración del consultorio.
                    </p>
                </div>
            </div>

            <div class="row g-3">

                <!-- USUARIOS -->
                <div class="col-sm-6 col-xl-3">
                    <div class="card dashboard-stat shadow-sm">
                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="stat-label">Usuarios registrados</span>

                                <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                                    <i class="bi bi-people-fill"></i>
                                </div>
                            </div>

                            <div class="stat-value">
                                @Model.TotalUsers
                            </div>

                            <div class="stat-label mt-2">
                                @Model.ActiveUsers activos · @Model.InactiveUsers inactivos
                            </div>

                        </div>
                    </div>
                </div>

                <!-- PROFESIONALES -->
                <div class="col-sm-6 col-xl-3">
                    <div class="card dashboard-stat shadow-sm">
                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="stat-label">Profesionales</span>

                                <div class="stat-icon bg-success bg-opacity-10 text-success">
                                    <i class="bi bi-person-badge-fill"></i>
                                </div>
                            </div>

                            <div class="stat-value">
                                @Model.TotalProfessionals
                            </div>

                            <div class="stat-label mt-2">
                                @Model.ActiveProfessionals activos
                            </div>

                        </div>
                    </div>
                </div>

                <!-- ESPECIALIDADES -->
                <div class="col-sm-6 col-xl-3">
                    <div class="card dashboard-stat shadow-sm">
                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="stat-label">Especialidades</span>

                                <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                                    <i class="bi bi-heart-pulse-fill"></i>
                                </div>
                            </div>

                            <div class="stat-value">
                                @Model.TotalSpecialties
                            </div>

                            <div class="stat-label mt-2">
                                @Model.ActiveSpecialties activas
                            </div>

                        </div>
                    </div>
                </div>

                <!-- USUARIOS ACTIVOS -->
                <div class="col-sm-6 col-xl-3">
                    <div class="card dashboard-stat shadow-sm">
                        <div class="card-body">

                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="stat-label">Usuarios activos</span>

                                <div class="stat-icon bg-info bg-opacity-10 text-info">
                                    <i class="bi bi-person-check-fill"></i>
                                </div>
                            </div>

                            <div class="stat-value">
                                @Model.ActiveUsers
                            </div>

                            <div class="stat-label mt-2">
                                De @Model.TotalUsers usuarios registrados
                            </div>

                        </div>
                    </div>
                </div>

            </div>

        </section>

        <!-- ÚLTIMOS USUARIOS -->
        <section class="card dashboard-card shadow-sm mb-5">

            <div class="card-body p-4">

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

                    <div>
                        <h5 class="dashboard-section-title mb-1">
                            Últimos usuarios registrados
                        </h5>

                        <p class="dashboard-muted small mb-0">
                            Los cinco usuarios incorporados más recientemente.
                        </p>
                    </div>

                    <a asp-area="Admin"
                       asp-controller="Users"
                       asp-action="Index"
                       class="btn btn-outline-primary btn-sm">

                        Ver todos
                        <i class="bi bi-arrow-right ms-1"></i>

                    </a>

                </div>

                <div class="table-responsive">

                    <table class="table dashboard-table mb-0">

                        <thead>
                            <tr>
                                <th>Usuario</th>
                                <th>Correo electrónico</th>
                                <th>Rol</th>
                                <th>Registro</th>
                                <th>Estado</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (recentUsers.Any())
                            {
                                @foreach (var user in recentUsers)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            @user.FullName
                                        </td>

                                        <td>
                                            @user.Email
                                        </td>

                                        <td>
                                            <span class="badge bg-light text-dark border">
                                                @user.Role
                                            </span>
                                        </td>

                                        <td>
                                            @user.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")
                                        </td>

                                        <td>
                                            @if (user.IsActive)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success">
                                                    Activo
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger">
                                                    Inactivo
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5"
                                        class="text-center py-4 dashboard-muted">
                                        No hay usuarios registrados para mostrar.
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </section>
    }

    <!-- ACCESOS RÁPIDOS -->
    <section class="dashboard-section mb-5">

        <div class="dashboard-section-heading">

            <div>
                <h3>Accesos rápidos</h3>

                <p>
                    Ingresá directamente a los módulos disponibles para tu rol.
                </p>
            </div>

        </div>

        <div class="row g-3">

            @if (isAdmin)
            {
                <!-- USUARIOS -->
                <div class="col-md-6 col-xl-4">
                    <div class="card dashboard-card shadow-sm h-100">
                        <div class="card-body">

                            <div class="dashboard-access-icon bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-people-fill"></i>
                            </div>

                            <h6 class="fw-bold">Usuarios</h6>

                            <p class="text-muted small">
                                Administrá las cuentas, los roles y los accesos al sistema.
                            </p>

                            <a asp-area="Admin"
                               asp-controller="Users"
                               asp-action="Index"
                               class="dashboard-access-link text-primary">

                                Administrar usuarios
                                <i class="bi bi-arrow-right ms-1"></i>

                            </a>

                        </div>
                    </div>
                </div>

                <!-- PROFESIONALES -->
                <div class="col-md-6 col-xl-4">
                    <div class="card dashboard-card shadow-sm h-100">
                        <div class="card-body">

                            <div class="dashboard-access-icon bg-success bg-opacity-10 text-success">
                                <i class="bi bi-person-badge-fill"></i>
                            </div>

                            <h6 class="fw-bold">Profesionales</h6>

                            <p class="text-muted small">
                                Gestioná los profesionales y sus datos laborales.
                            </p>

                            <a asp-area="Admin"
                               asp-controller="Professionals"
                               asp-action="Index"
                               class="dashboard-access-link text-success">

                                Administrar profesionales
                                <i class="bi bi-arrow-right ms-1"></i>

                            </a>

                        </div>
                    </div>
                </div>

                <!-- ESPECIALIDADES -->
                <div class="col-md-6 col-xl-4">
                    <div class="card dashboard-card shadow-sm h-100">
                        <div class="card-body">

                            <div class="dashboard-access-icon bg-warning bg-opacity-10 text-warning">
                                <i class="bi bi-heart-pulse-fill"></i>
                            </div>

                            <h6 class="fw-bold">Especialidades</h6>

                            <p class="text-muted small">
                                Administrá las especialidades médicas del consultorio.
                            </p>

                            <a asp-area="Admin"
                               asp-controller="Specialties"
                               asp-action="Index"
                               class="dashboard-access-link text-warning">

                                Administrar especialidades
                                <i class="bi bi-arrow-right ms-1"></i>

                            </a>

                        </div>
                    </div>
                </div>
            }

            @if (isReceptionist)
            {
                <!-- PACIENTES -->
                <div class="col-md-6 col-xl-4">
                    <div class="card dashboard-card shadow-sm h-100">
                        <div class="card-body">

                            <div class="dashboard-access-icon bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-people-fill"></i>
                            </div>

                            <h6 class="fw-bold">Pacientes</h6>

                            <p class="text-muted small">
                                Registrá, consultá y administrá la información de los pacientes.
                            </p>

                            <a asp-area="Reception"
                               asp-controller="Patients"
                               asp-action="Index"
                               class="dashboard-access-link text-primary">

                                Ir a pacientes
                                <i class="bi bi-arrow-right ms-1"></i>

                            </a>

                        </div>
                    </div>
                </div>

                <!-- TURNOS -->
                <div class="col-md-6 col-xl-4">
                    <div class="card dashboard-card shadow-sm h-100">
                        <div class="card-body">

                            <div class="dashboard-access-icon bg-success bg-opacity-10 text-success">
                                <i class="bi bi-calendar-check-fill"></i>
                            </div>

                            <h6 class="fw-bold">Gestión de turnos</h6>

                            <p class="text-muted small">
                                Asigná, confirmá, cancelá y reprogramá los turnos.
                            </p>

                            <a asp-area="Reception"
                               asp-controller="Appointments"
                               asp-action="Index"
                               class="dashboard-access-link text-success">

                                Ir a turnos
                                <i class="bi bi-arrow-right ms-1"></i>

                            </a>

                        </div>
                    </div>
                </div>
            }

            @if (isDoctor)
            {
                <!-- AGENDA -->
                <div class="col-md-6 col-xl-4">
                    <div class="card dashboard-card shadow-sm h-100">
                        <div class="card-body">

                            <div class="dashboard-access-icon bg-info bg-opacity-10 text-info">
                                <i class="bi bi-calendar-week-fill"></i>
                            </div>

                            <h6 class="fw-bold">Mi agenda</h6>

                            <p class="text-muted small">
                                Consultá y administrá tus horarios de atención.
                            </p>

                            <a asp-area="Doctor"
                               asp-controller="ProfessionalSchedules"
                               asp-action="Index"
                               class="dashboard-access-link text-info">

                                Administrar agenda
                                <i class="bi bi-arrow-right ms-1"></i>

                            </a>

                        </div>
                    </div>
                </div>

                <!-- EXCEPCIONES -->
                <div class="col-md-6 col-xl-4">
                    <div class="card dashboard-card shadow-sm h-100">
                        <div class="card-body">

                            <div class="dashboard-access-icon bg-danger bg-opacity-10 text-danger">
                                <i class="bi bi-calendar-x-fill"></i>
                            </div>

                            <h6 class="fw-bold">Excepciones</h6>

                            <p class="text-muted small">
                                Gestioná vacaciones, licencias y bloqueos de horarios.
                            </p>

                            <a asp-area="Doctor"
                               asp-controller="ScheduleExceptions"
                               asp-action="Index"
                               class="dashboard-access-link text-danger">

                                Administrar excepciones
                                <i class="bi bi-arrow-right ms-1"></i>

                            </a>

                        </div>
                    </div>
                </div>
            }

        </div>

    </section>

    <!-- INFORMACIÓN INFERIOR -->
    <section class="row g-3 mb-4">

        <div class="col-12">
            <div class="card dashboard-card shadow-sm h-100">
                <div class="card-body p-4">

                    <h6 class="dashboard-section-title mb-3">
                        <i class="bi bi-info-circle text-primary me-2"></i>
                        Sobre MediGest
                    </h6>

                    <p class="text-muted small mb-0">
                        MediGest es un sistema de gestión de consultorio médico
                        diseñado para centralizar la información de los pacientes,
                        organizar las agendas profesionales y facilitar la
                        administración de turnos.
                    </p>

                </div>
            </div>
        </div>

    </section>

</div>
