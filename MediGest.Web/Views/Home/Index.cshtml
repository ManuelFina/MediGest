
@{
    ViewData["Title"] = "Inicio";

    var isAdmin = User.IsInRole("Administrator");
    var isReceptionist = User.IsInRole("Receptionist");
    var isDoctor = User.IsInRole("Doctor");

    var userName = User.Identity?.Name ?? "Usuario";
}

<div class="container-fluid px-0">

    <!-- Encabezado -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">¡Bienvenido a MediGest!</h3>
            <p class="text-muted mb-0">
                Hola, <strong>@userName</strong>. Este es tu espacio de trabajo.
            </p>
        </div>

        <div class="text-muted small mt-3 mt-md-0">
            <i class="bi bi-calendar3 me-2"></i>
            @DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy",
            new System.Globalization.CultureInfo("es-AR"))
        </div>
    </div>

    <!-- Bienvenida -->
    <div class="card border-0 shadow-sm mb-4 overflow-hidden"
         style="background: linear-gradient(110deg, #1d4e89, #3678e5); border-radius: 14px;">
        <div class="card-body p-4 p-md-5 text-white">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <span class="badge bg-white text-primary mb-3">
                        MediGest · Gestión médica
                    </span>

                    <h2 class="fw-bold mb-2">
                        Gestioná tu consultorio de forma sencilla.
                    </h2>

                    <p class="mb-0 opacity-75">
                        Accedé a las herramientas de gestión y mantené
                        organizada la atención de tus pacientes.
                    </p>
                </div>

                <div class="col-lg-4 text-center d-none d-lg-block">
                    <i class="bi bi-hospital"
                       style="font-size: 100px; opacity: .2;"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Accesos rápidos -->
    <div class="mb-4">
        <div class="mb-3">
            <h5 class="fw-bold mb-1">Accesos rápidos</h5>
            <p class="text-muted small mb-0">
                Seleccioná el módulo al que querés ingresar.
            </p>
        </div>

        <div class="row g-3">

            @if (isAdmin || isReceptionist)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="rounded-3 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center mb-3"
                                 style="width: 48px; height: 48px;">
                                <i class="bi bi-people-fill fs-4"></i>
                            </div>

                            <h5 class="fw-bold">Pacientes</h5>
                            <p class="text-muted small">
                                Registrá, consultá y administrá la información de los pacientes.
                            </p>

                            <a asp-area="Reception"
                               asp-controller="Patients"
                               asp-action="Index"
                               class="btn btn-outline-primary btn-sm">
                                Ir a pacientes
                                <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-xl-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="rounded-3 bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center mb-3"
                                 style="width: 48px; height: 48px;">
                                <i class="bi bi-calendar-check-fill fs-4"></i>
                            </div>

                            <h5 class="fw-bold">Gestión de turnos</h5>
                            <p class="text-muted small">
                                Asigná, confirmá, cancelá y reprogramá los turnos.
                            </p>

                            <a asp-area="Reception"
                               asp-controller="Appointments"
                               asp-action="Index"
                               class="btn btn-outline-success btn-sm">
                                Ir a turnos
                                <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }

            @if (isAdmin)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="rounded-3 bg-warning bg-opacity-10 text-warning d-flex align-items-center justify-content-center mb-3"
                                 style="width: 48px; height: 48px;">
                                <i class="bi bi-person-badge-fill fs-4"></i>
                            </div>

                            <h5 class="fw-bold">Profesionales</h5>
                            <p class="text-muted small">
                                Administrá los profesionales registrados en el consultorio.
                            </p>

                            <a asp-area="Admin"
                               asp-controller="Professionals"
                               asp-action="Index"
                               class="btn btn-outline-warning btn-sm">
                                Ir a profesionales
                                <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }

            @if (isDoctor)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="rounded-3 bg-info bg-opacity-10 text-info d-flex align-items-center justify-content-center mb-3"
                                 style="width: 48px; height: 48px;">
                                <i class="bi bi-calendar-week-fill fs-4"></i>
                            </div>

                            <h5 class="fw-bold">Mi agenda</h5>
                            <p class="text-muted small">
                                Configurá tus horarios y períodos de atención.
                            </p>

                            <a asp-area="Doctor"
                               asp-controller="ProfessionalSchedules"
                               asp-action="Index"
                               class="btn btn-outline-info btn-sm">
                                Administrar agenda
                                <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-xl-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <div class="rounded-3 bg-danger bg-opacity-10 text-danger d-flex align-items-center justify-content-center mb-3"
                                 style="width: 48px; height: 48px;">
                                <i class="bi bi-calendar-x-fill fs-4"></i>
                            </div>

                            <h5 class="fw-bold">Excepciones</h5>
                            <p class="text-muted small">
                                Gestioná vacaciones, licencias y bloqueos de horarios.
                            </p>

                            <a asp-area="Doctor"
                               asp-controller="ScheduleExceptions"
                               asp-action="Index"
                               class="btn btn-outline-danger btn-sm">
                                Administrar excepciones
                                <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>

    <!-- Información inferior -->
    <div class="row g-3">

        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-info-circle text-primary me-2"></i>
                        Sobre MediGest
                    </h5>

                    <p class="text-muted mb-0">
                        MediGest es un sistema de gestión de consultorio médico
                        diseñado para centralizar la información de los pacientes,
                        organizar las agendas profesionales y facilitar la
                        administración de turnos.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-shield-check text-success me-2"></i>
                        Tu sesión
                    </h5>

                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center"
                             style="width: 48px; height: 48px;">
                            <i class="bi bi-person-fill fs-4"></i>
                        </div>

                        <div>
                            <div class="fw-semibold">@userName</div>
                            <small class="text-muted">
                                @(isAdmin ? "Administrador" :
                                  isReceptionist ? "Recepcionista" :
                                  isDoctor ? "Profesional médico" : "Usuario")
                            </small>
                        </div>
                    </div>

                    <hr />

                    <div class="small text-success">
                        <i class="bi bi-circle-fill me-2" style="font-size: 8px;"></i>
                        Sesión iniciada correctamente
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>
