@model MediGest.Web.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MediGest</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            body {
                min-height: 100vh;
                font-family: "Segoe UI", sans-serif;
                background: linear-gradient( 90deg, rgba(8, 28, 48, 0.82) 0%, rgba(8, 28, 48, 0.65) 45%, rgba(8, 28, 48, 0.30) 100% ), url("https://www.stantec.com/content/dam/stantec/images/projects/0010/ann-robert-lurie-childrens-hospital-139048.jpg") center center / cover no-repeat fixed;
            }

            .login-container {
                min-height: 100vh;
                display: flex;
                align-items: center;
                padding: 60px 8%;
            }

            .brand-section {
                color: white;
                max-width: 600px;
                padding-right: 50px;
            }

            .brand-icon {
                width: 76px;
                height: 76px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(255, 255, 255, 0.15);
                border: 1px solid rgba(255, 255, 255, 0.25);
                border-radius: 20px;
                font-size: 38px;
                margin-bottom: 28px;
            }

            .brand-title {
                font-size: 3.5rem;
                font-weight: 700;
                letter-spacing: -1.5px;
                margin-bottom: 15px;
            }

            .brand-description {
                font-size: 1.15rem;
                line-height: 1.8;
                color: rgba(255, 255, 255, 0.85);
                max-width: 480px;
            }

            .brand-divider {
                width: 70px;
                height: 4px;
                background: #58b9e8;
                border-radius: 10px;
                margin: 25px 0;
            }

            .login-card {
                width: 100%;
                max-width: 460px;
                margin-left: auto;
                background: rgba(255, 255, 255, 0.97);
                border-radius: 20px;
                padding: 45px;
                box-shadow: 0 25px 70px rgba(0, 0, 0, 0.25);
            }

            .login-heading {
                font-size: 1.8rem;
                font-weight: 700;
                color: #173b59;
            }

            .login-subtitle {
                color: #788692;
                font-size: 0.95rem;
            }

            .form-label {
                color: #34495e;
                font-weight: 600;
                font-size: 0.9rem;
            }

            .form-control {
                min-height: 50px;
                border: 1px solid #dce3e9;
                border-radius: 9px;
                padding: 12px 15px;
            }

                .form-control:focus {
                    border-color: #2385bd;
                    box-shadow: 0 0 0 0.2rem rgba(35, 133, 189, 0.13);
                }

            .input-group-text {
                background: #f4f7f9;
                border: 1px solid #dce3e9;
                border-radius: 9px 0 0 9px;
                color: #628096;
                padding: 0 16px;
            }

            .input-group .form-control {
                border-radius: 0 9px 9px 0;
            }

            .btn-login {
                min-height: 52px;
                border-radius: 9px;
                background: #176fa5;
                border: none;
                color: white;
                font-weight: 600;
                font-size: 1rem;
                transition: background 0.2s ease;
            }

                .btn-login:hover {
                    background: #125b89;
                    color: white;
                }

            .login-footer {
                color: #8a969f;
                font-size: 0.8rem;
                border-top: 1px solid #edf0f2;
                padding-top: 22px;
                margin-top: 30px;
            }

            .security-text {
                color: #788692;
                font-size: 0.85rem;
            }

            @@media (max-width: 991px) {
                .login-container {
                    padding: 40px 5%;
                    justify-content: center;
                }

                .brand-section {
                    display: none;
                }

                .login-card {
                    margin: 0 auto;
                }
            }

            @@media (max-width: 576px) {
                .login-card {
                    padding: 30px 24px;
                }

                .login-heading {
                    font-size: 1.5rem;
                }
            }
    </style>
</head>

<body>
    <main class="login-container">
        <div class="container-fluid">
            <div class="row align-items-center">

                <!-- Brand section -->
                <div class="col-lg-7">
                    <section class="brand-section">
                        <div class="brand-icon">
                            <i class="bi bi-hospital"></i>
                        </div>

                        <h1 class="brand-title">MediGest</h1>

                        <div class="brand-divider"></div>

                        <h2 class="h3 fw-semibold mb-3">
                            Gestión médica, simple y eficiente.
                        </h2>

                        <p class="brand-description">
                            Una plataforma integral para administrar
                            consultorios médicos, organizar turnos y
                            centralizar la información de los pacientes.
                        </p>
                    </section>
                </div>

                <!-- Login section -->
                <div class="col-lg-5">
                    <section class="login-card">

                        <div class="mb-4">
                            <h2 class="login-heading mb-2">
                                Bienvenido
                            </h2>

                            <p class="login-subtitle mb-0">
                                Ingresá tus credenciales para acceder al sistema.
                            </p>
                        </div>

                        <form asp-controller="Account"
                              asp-action="Login"
                              method="post">

                            <input type="hidden"
                                   name="returnUrl"
                                   value="@ViewData["ReturnUrl"]" />

                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger small"
                                 role="alert">
                            </div>

                            <div class="mb-4">
                                <label asp-for="Email" class="form-label mb-2"></label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-envelope"></i>
                                    </span>

                                    <input asp-for="Email"
                                           class="form-control"
                                           placeholder="correo@ejemplo.com"
                                           autocomplete="username" />
                                </div>

                                <span asp-validation-for="Email"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Password" class="form-label mb-2"></label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-lock"></i>
                                    </span>

                                    <input asp-for="Password"
                                           class="form-control"
                                           placeholder="Ingresá tu contraseña"
                                           autocomplete="current-password" />
                                </div>

                                <span asp-validation-for="Password"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <div class="form-check">
                                    <input asp-for="RememberMe"
                                           class="form-check-input" />

                                    <label asp-for="RememberMe"
                                           class="form-check-label small">
                                    </label>
                                </div>
                            </div>

                            <button type="submit"
                                    class="btn btn-login w-100">
                                <i class="bi bi-box-arrow-in-right me-2"></i>
                                Iniciar sesión
                            </button>
                        </form>

                        <div class="text-center login-footer">
                            <div class="security-text mb-2">
                                <i class="bi bi-shield-lock me-1"></i>
                                Acceso seguro al sistema
                            </div>

                            © @DateTime.Now.Year MediGest
                            · Sistema de gestión médica
                        </div>

                    </section>
                </div>

            </div>
        </div>
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
