
@using Microsoft.AspNetCore.Identity
@using MediGest.Web.Models.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var isAuthenticated = SignInManager.IsSignedIn(User);

    var currentUser = isAuthenticated
        ? await UserManager.GetUserAsync(User)
        : null;

    var userName = currentUser != null
        ? $"{currentUser.FirstName} {currentUser.LastName}".Trim()
        : "Usuario";

    if (string.IsNullOrWhiteSpace(userName))
    {
        userName = "Usuario";
    }

    var isAdmin = User.IsInRole(ApplicationRoles.Administrator);
    var isReceptionist = User.IsInRole(ApplicationRoles.Receptionist);
    var isDoctor = User.IsInRole(ApplicationRoles.Doctor);

    var userRole = isAdmin
        ? "Administrador"
        : isReceptionist
            ? "Recepcionista"
            : isDoctor
                ? "Profesional"
                : "Usuario";

    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var isLoginPage =
        currentController == "Account" &&
        currentAction == "Login";

    var isHomeActive =
        string.IsNullOrEmpty(currentArea) &&
        currentController == "Home";

    var avatarLetter = userName[0].ToString().ToUpperInvariant();

    var pageTitle = ViewData["Title"]?.ToString() ?? "Inicio";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@pageTitle | MediGest</title>

    <meta name="description"
          content="MediGest - Sistema de gestión de consultorio médico." />

    <!-- Tipografía -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <!-- Frameworks y estilos -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/MediGest.Web.styles.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

@if (isAuthenticated && !isLoginPage)
{
    <!-- SIDEBAR -->
    <aside class="mg-sidebar">

        <!-- MARCA -->
        <a asp-area=""
           asp-controller="Home"
           asp-action="Index"
           class="mg-brand">

            <span class="mg-brand-icon">
                <i class="bi bi-heart-pulse-fill"></i>
            </span>

            <span class="mg-brand-text">MediGest</span>

        </a>

        <!-- NAVEGACIÓN -->
        <nav class="mg-sidebar-navigation">

            <!-- PRINCIPAL -->
            <div class="mg-menu-label">
                Principal
            </div>

            <a asp-area=""
               asp-controller="Home"
               asp-action="Index"
               class="mg-nav-link @(isHomeActive ? "active" : "")">

                <i class="bi bi-grid-1x2-fill"></i>
                <span>Inicio</span>

            </a>

            <!-- ADMINISTRADOR -->
            @if (isAdmin)
            {
                <div class="mg-menu-label">
                    Administración
                </div>

                <a asp-area="Admin"
                   asp-controller="Users"
                   asp-action="Index"
                   class="mg-nav-link @(currentArea == "Admin" && currentController == "Users" ? "active" : "")">

                    <i class="bi bi-people-fill"></i>
                    <span>Usuarios</span>

                </a>

                <a asp-area="Admin"
                   asp-controller="Professionals"
                   asp-action="Index"
                   class="mg-nav-link @(currentArea == "Admin" && currentController == "Professionals" ? "active" : "")">

                    <i class="bi bi-person-badge-fill"></i>
                    <span>Profesionales</span>

                </a>

                <a asp-area="Admin"
                   asp-controller="Specialties"
                   asp-action="Index"
                   class="mg-nav-link @(currentArea == "Admin" && currentController == "Specialties" ? "active" : "")">

                    <i class="bi bi-heart-pulse"></i>
                    <span>Especialidades</span>

                </a>

                <div class="mg-menu-label">
                    Prestaciones y servicios
                </div>

                <a asp-area="Admin"
                   asp-controller="MedicalServices"
                   asp-action="Index"
                   class="mg-nav-link @(currentArea == "Admin" && currentController == "MedicalServices" ? "active" : "")">

                    <i class="bi bi-clipboard2-pulse"></i>
                    <span>Prestaciones médicas</span>

                </a>

                <div class="mg-menu-label">
                    Coberturas y facturación
                </div>

                <a asp-area="Admin"
                   asp-controller="HealthInsurances"
                   asp-action="Index"
                   class="mg-nav-link @(currentArea == "Admin" && currentController == "HealthInsurances" ? "active" : "")">

                    <i class="bi bi-shield-check"></i>
                    <span>Obras sociales y prepagas</span>

                </a>

                <a asp-area="Admin"
                   asp-controller="HealthPlans"
                   asp-action="Index"
                   class="mg-nav-link @(currentArea == "Admin" && currentController == "HealthPlans" ? "active" : "")">

                    <i class="bi bi-layers"></i>
                    <span>Planes de cobertura</span>

                </a>

                <a asp-area="Admin"
                   asp-controller="HealthPlanTariffs"
                   asp-action="Index"
                   class="mg-nav-link @(currentArea == "Admin" && currentController == "HealthPlanTariffs" ? "active" : "")">

                    <i class="bi bi-currency-dollar"></i>
                    <span>Tarifas por plan</span>

                </a>
            }

            <!-- RECEPCIONISTA -->
            @if (isReceptionist)
            {
                <div class="mg-menu-label">
                    Atención de pacientes
                </div>

                <a asp-area="Reception"
                   asp-controller="Patients"
                   asp-action="Index"
                   class="mg-nav-link @(currentArea == "Reception" && currentController == "Patients" ? "active" : "")">

                    <i class="bi bi-person-lines-fill"></i>
                    <span>Pacientes</span>

                </a>

                <a asp-area="Reception"
                   asp-controller="Appointments"
                   asp-action="Index"
                   class="mg-nav-link @(currentArea == "Reception" && currentController == "Appointments" ? "active" : "")">

                    <i class="bi bi-calendar-check-fill"></i>
                    <span>Turnos</span>

                </a>
            }

            <!-- PROFESIONAL -->
            @if (isDoctor)
            {
                <div class="mg-menu-label">
                    Mi espacio
                </div>

                <a asp-area="Doctor"
                   asp-controller="Appointments"
                   asp-action="Index"
                   class="mg-nav-link @(currentArea == "Doctor" && currentController == "Appointments" ? "active" : "")">

                    <i class="bi bi-calendar-check-fill"></i>
                    <span>Mi agenda</span>

                </a>

                <a asp-area="Doctor"
                   asp-controller="ProfessionalSchedules"
                   asp-action="Index"
                   class="mg-nav-link @(currentArea == "Doctor" && currentController == "ProfessionalSchedules" ? "active" : "")">

                    <i class="bi bi-calendar-week-fill"></i>
                    <span>Mis horarios</span>

                </a>

                <a asp-area="Doctor"
                   asp-controller="ScheduleExceptions"
                   asp-action="Index"
                   class="mg-nav-link @(currentArea == "Doctor" && currentController == "ScheduleExceptions" ? "active" : "")">

                    <i class="bi bi-calendar-x-fill"></i>
                    <span>Excepciones</span>

                </a>
            }

        </nav>

        <!-- USUARIO Y CIERRE DE SESIÓN -->
        <div class="mg-sidebar-footer">

            <div class="mg-user">

                <div class="mg-avatar">
                    @avatarLetter
                </div>

                <div class="mg-user-info">
                    <strong>@userName</strong>
                    <small>@userRole</small>
                </div>

            </div>

            <form asp-area=""
                  asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                <button type="submit" class="mg-nav-link mg-logout">
                    <i class="bi bi-box-arrow-left"></i>
                    <span>Cerrar sesión</span>
                </button>

            </form>

        </div>

    </aside>

    <!-- CONTENIDO PRINCIPAL -->
    <div class="mg-main">

        <!-- TOPBAR -->
        <header class="mg-topbar">

            <div class="mg-topbar-title">
                <span class="mg-topbar-label">MediGest</span>
                <span class="mg-topbar-divider">/</span>
                <span class="mg-topbar-current">@pageTitle</span>
            </div>

            <div class="mg-topbar-user">
                <i class="bi bi-shield-check"></i>
                <span>@userRole</span>
            </div>

        </header>

        <!-- VISTA -->
        <main class="mg-content">
            @RenderBody()
        </main>

        <!-- FOOTER -->
        <footer class="mg-footer">
            <span>© @DateTime.Now.Year MediGest</span>
            <span>Sistema de gestión de consultorio médico</span>
        </footer>

    </div>
}
else
{
    <!-- VISTAS PÚBLICAS: LOGIN Y OTRAS -->
    <main class="mg-public-content">
        @RenderBody()
    </main>
}

<!-- SCRIPTS -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="~/js/site.js" asp-append-version="true"></script>

<!-- NOTIFICACIONES GLOBALES -->
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const successMessage = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(TempData["Success"])
        );

        const errorMessage = @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(TempData["Error"])
        );

        if (successMessage) {
            Swal.fire({
                icon: 'success',
                title: '¡Operación exitosa!',
                text: successMessage,
                confirmButtonText: 'Aceptar',
                confirmButtonColor: '#2674ed'
            });
        }

        if (errorMessage) {
            Swal.fire({
                icon: 'error',
                title: 'No se pudo completar la operación',
                text: errorMessage,
                confirmButtonText: 'Aceptar',
                confirmButtonColor: '#2674ed'
            });
        }

    });
</script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
